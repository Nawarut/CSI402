@model Nawarut_8250_L005.ViewModels.AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "แดชบอร์ด (Dashboard)";
}

<div class="container-fluid px-0">

    <!-- Eyebrow & Headline -->
    <div class="d-flex flex-wrap justify-content-between align-items-baseline mb-4">
        <div>
            <span class="origin-mono" style="color: var(--color-iris-gleam); font-size: 11px;">METRICS &middot; ภาพรวมระบบโรงแรม</span>
            <h2 class="origin-heading-lg mt-1 mb-0" style="font-size: 32px;">แผงสถิติและการดำเนินงาน (ข้อมูลจริงจากระบบ)</h2>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="origin-mono" style="color: var(--color-cyan-signal); font-size: 11px;">
                <span class="spinner-grow spinner-grow-sm me-1" role="status"></span> อัปเดตข้อมูลแบบเรียลไทม์: @DateTime.Now.ToString("HH:mm") น.
            </span>
        </div>
    </div>

    <!-- Stat Cards Row (Graphite Cards, 16px radius) - 100% ข้อมูลจริงจากฐานข้อมูล -->
    <div class="row g-4 mb-5">

        <!-- Stat 1: Total Rooms -->
        <div class="col-12 col-sm-6 col-xl-3">
            <a asp-controller="Admin" asp-action="Rooms" class="text-decoration-none">
                <div class="origin-card-graphite p-4 h-100 position-relative overflow-hidden" style="cursor: pointer; transition: all 0.2s ease;">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="origin-mono" style="color: var(--color-ash); font-size: 11px;">ห้องพักทั้งหมด</span>
                        <span class="origin-pill-chip py-1 px-2" style="font-size: 10px; color: var(--color-cyan-signal); border-color: rgba(0,179,221,0.3);">
                            CAPACITY
                        </span>
                    </div>
                    <div class="origin-heading-lg mb-1" style="font-size: 36px; color: var(--color-pure);">
                        @Model.TotalRooms <span class="origin-mono" style="font-size: 13px; color: var(--color-ash);">ห้อง</span>
                    </div>
                    <div class="origin-mono" style="color: var(--color-cyan-signal); font-size: 11px;">
                        ✓ ว่าง @Model.AvailableRooms ห้อง &middot; ซ่อมบำรุง @Model.MaintenanceRooms ห้อง
                    </div>
                </div>
            </a>
        </div>

        <!-- Stat 2: Booked / Occupied Rooms -->
        <div class="col-12 col-sm-6 col-xl-3">
            <a asp-controller="Admin" asp-action="Rooms" asp-route-statusFilter="Booked" class="text-decoration-none">
                <div class="origin-card-graphite p-4 h-100 position-relative overflow-hidden" style="cursor: pointer; transition: all 0.2s ease;">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="origin-mono" style="color: var(--color-ash); font-size: 11px;">ห้องที่ถูกจองแล้ว</span>
                        <span class="origin-pill-chip py-1 px-2" style="font-size: 10px; color: var(--color-orchid-bloom); border-color: rgba(221,144,216,0.3);">
                            OCCUPANCY
                        </span>
                    </div>
                    <div class="origin-heading-lg mb-1" style="font-size: 36px; color: var(--color-orchid-bloom);">
                        @Model.OccupiedRooms <span class="origin-mono" style="font-size: 13px; color: var(--color-ash);">ห้อง</span>
                    </div>
                    <div class="origin-mono" style="color: var(--color-ash); font-size: 11px;">
                        อัตราเข้าพัก @Model.OccupancyRate% &middot; วันนี้
                    </div>
                </div>
            </a>
        </div>

        <!-- Stat 3: Total Users -->
        <div class="col-12 col-sm-6 col-xl-3">
            <a asp-controller="Home" asp-action="Lab5_3" class="text-decoration-none">
                <div class="origin-card-graphite p-4 h-100 position-relative overflow-hidden" style="cursor: pointer; transition: all 0.2s ease;">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="origin-mono" style="color: var(--color-ash); font-size: 11px;">ผู้ใช้งาน (User List)</span>
                        <span class="origin-pill-chip py-1 px-2" style="font-size: 10px; color: var(--color-iris-gleam); border-color: rgba(132,125,255,0.3);">
                            RESIDENTS
                        </span>
                    </div>
                    <div class="origin-heading-lg mb-1" style="font-size: 36px; color: var(--color-iris-gleam);">
                        @Model.TotalUsers <span class="origin-mono" style="font-size: 13px; color: var(--color-ash);">บัญชี</span>
                    </div>
                    <div class="origin-mono" style="color: var(--color-pure); font-size: 11px;">
                        ลูกค้า @Model.RenterUsers บัญชี &middot; แอดมิน/จนท. @Model.StaffUsers บัญชี &rarr;
                    </div>
                </div>
            </a>
        </div>

        <!-- Stat 4: Total Bookings -->
        <div class="col-12 col-sm-6 col-xl-3">
            <a asp-controller="Admin" asp-action="Bookings" class="text-decoration-none">
                <div class="origin-card-graphite p-4 h-100 position-relative overflow-hidden" style="cursor: pointer; transition: all 0.2s ease;">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="origin-mono" style="color: var(--color-ash); font-size: 11px;">ยอดการจองสะสม</span>
                        <span class="origin-pill-chip py-1 px-2" style="font-size: 10px; color: var(--color-periwinkle); border-color: rgba(144,184,240,0.3);">
                            RESERVATIONS
                        </span>
                    </div>
                    <div class="origin-heading-lg mb-1" style="font-size: 36px; color: var(--color-periwinkle);">
                        @Model.TotalBookings <span class="origin-mono" style="font-size: 13px; color: var(--color-ash);">รายการ</span>
                    </div>
                    <div class="origin-mono" style="color: var(--color-ash); font-size: 11px;">
                        มัดจำรับแล้ว ฿@Model.TotalDepositAmount.ToString("N0") &middot; ยืนยัน @Model.ConfirmedBookings รายการ
                    </div>
                </div>
            </a>
        </div>

    </div>

    <!-- Quick Action / Management Cards -->
    <div class="row g-4 mb-5">
        <div class="col-12 col-lg-8">
            <!-- Recent Bookings Table Card (100% ข้อมูลจริงจากตาราง Bookings) -->
            <div class="origin-card-graphite p-0 overflow-hidden">
                <div class="p-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: rgba(255,255,255,0.08) !important;">
                    <div>
                        <span class="origin-mono" style="color: var(--color-iris-gleam); font-size: 11px;">TRANSACTIONS</span>
                        <h3 class="origin-heading-lg mb-0" style="font-size: 22px;">รายการจองล่าสุด (ข้อมูลจริง)</h3>
                    </div>
                    <a asp-controller="Admin" asp-action="Bookings" class="origin-mono text-decoration-none" style="color: var(--color-cyan-signal); font-size: 11px;">
                        ดูรายการจองทั้งหมด (@Model.TotalBookings) &rarr;
                    </a>
                </div>

                <div class="table-responsive" style="background-color: var(--color-abyss) !important;">
                    <table class="table origin-table mb-0" style="background-color: transparent !important; color: #ffffff !important;">
                        <thead>
                            <tr class="origin-mono border-bottom" style="border-color: rgba(255,255,255,0.08) !important; color: var(--color-ash); font-size: 11px;">
                                <th class="p-3">BOOKING CODE</th>
                                <th class="p-3">ผู้เข้าพัก</th>
                                <th class="p-3">ห้องพัก</th>
                                <th class="p-3 text-center">วันที่เข้าพัก</th>
                                <th class="p-3 text-center">เวลามาตรฐาน</th>
                                <th class="p-3 text-end">มัดจำ 5%</th>
                                <th class="p-3 text-end">สถานะ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentBookings != null && Model.RecentBookings.Any())
                            {
                                @foreach (var b in Model.RecentBookings)
                                {
                                    <tr class="border-bottom" style="border-color: rgba(255,255,255,0.05) !important;">
                                        <td class="p-3 align-middle origin-mono text-white fw-bold">
                                            #@b.BookingCode
                                        </td>
                                        <td class="p-3 align-middle">
                                            <div class="fw-bold">@b.GuestName</div>
                                            <div class="origin-mono" style="color: var(--color-ash); font-size: 11px;">@b.GuestEmail</div>
                                        </td>
                                        <td class="p-3 align-middle">
                                            <div class="fw-bold text-truncate" style="max-width: 200px;">@b.RoomSummary</div>
                                            <div class="origin-mono" style="color: var(--color-ash); font-size: 11px;">@b.Nights คืน &middot; @b.TotalGuests ผู้เข้าพัก</div>
                                        </td>
                                        <td class="p-3 align-middle text-center origin-mono" style="color: var(--color-cloud); font-size: 12px;">
                                            @b.CheckInDate.ToString("dd/MM/yyyy")
                                        </td>
                                        <td class="p-3 align-middle text-center origin-mono" style="color: var(--color-cyan-signal); font-size: 11px;">
                                            09:00 - 12:00
                                        </td>
                                        <td class="p-3 align-middle text-end origin-mono" style="color: var(--color-cyan-signal);">
                                            ฿@b.DepositAmount.ToString("N0")
                                        </td>
                                        <td class="p-3 align-middle text-end">
                                            <span class="badge border rounded-pill px-3 py-1"
                                                  style="border-color: @b.StatusColor; color: @b.StatusColor; background: @(b.StatusColor)1a; font-size: 10px;">
                                                ● @b.StatusLabel
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="p-5 text-center text-muted">
                                        <div class="origin-mono mb-2" style="color: var(--color-ash);">ยังไม่มีรายการจองในระบบ</div>
                                        <a asp-controller="Home" asp-action="Index" class="btn-origin-primary py-1 px-3 text-decoration-none" style="font-size: 12px;">
                                            ไปที่หน้าจองห้องพัก &rarr;
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Quick Access Column -->
        <div class="col-12 col-lg-4">
            <div class="origin-card-graphite p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <span class="origin-mono" style="color: var(--color-iris-gleam); font-size: 11px;">QUICK CONTROLS</span>
                    <h3 class="origin-heading-lg mb-3" style="font-size: 22px;">เมนูการจัดการ</h3>
                    <p class="origin-body mb-4" style="font-size: 13.5px; color: var(--color-ash);">
                        จัดการระบบโรงแรม ข้อมูลห้องพัก โปรโมชั่น และรายการจองทั้งหมด
                    </p>

                    <div class="d-flex flex-column gap-2 mb-4">
                        <a asp-controller="Admin" asp-action="Rooms" class="btn-origin-primary w-100 justify-content-center py-2 text-decoration-none">
                            <i class="bi bi-door-closed me-1"></i> จัดการห้องพัก (@Model.TotalRooms ห้อง) &rarr;
                        </a>
                        <a asp-controller="Admin" asp-action="Promotions" class="btn-origin-ghost w-100 justify-content-center py-2 text-decoration-none">
                            <i class="bi bi-tag me-1"></i> จัดการโปรโมชั่น (@Model.TotalPromotions รายการ)
                        </a>
                        <a asp-controller="Admin" asp-action="Bookings" class="btn-origin-ghost w-100 justify-content-center py-2 text-decoration-none">
                            <i class="bi bi-calendar3 me-1"></i> รายการจอง (@Model.TotalBookings รายการ)
                        </a>
                        <a asp-controller="Home" asp-action="Lab5_3" class="btn-origin-ghost w-100 justify-content-center py-2 text-decoration-none">
                            <i class="bi bi-people me-1"></i> จัดการบัญชีผู้ใช้ (@Model.TotalUsers บัญชี)
                        </a>
                    </div>
                </div>

                <div class="p-3 rounded-3" style="background: rgba(15,16,17,0.7); border: 1px solid rgba(255,255,255,0.08);">
                    <div class="origin-mono" style="color: var(--color-cyan-signal); font-size: 10px;">STANDARD OPERATING HOURS</div>
                    <div class="small text-white mt-1">เช็คอิน: <strong>09:00 น.</strong> | เช็คเอาท์: <strong>12:00 น.</strong></div>
                </div>
            </div>
        </div>
    </div>

</div>
