            <tbody>

                <tr>
                    <td>#BK001</td>
                    <td>สมชาย</td>
                    <td>Deluxe Room</td>
                    <td>12/09/2026</td>
                    <td>
                        <span class="badge bg-success">
                            ยืนยันแล้ว
