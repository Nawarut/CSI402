@model Nawarut_8250_L005.Models.AddUserViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "เพิ่มผู้ใช้งาน (Add User)";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">

            <!-- Breadcrumb & Back -->
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="d-flex align-items-center gap-2">
                    <a asp-action="Users" asp-controller="Admin" class="btn-origin-ghost py-1 px-3" style="font-size: 12px;">
                        &larr; กลับหน้ารายชื่อ
                    </a>
                    <span class="origin-mono" style="color: var(--color-ash); font-size: 11px;">/ การจัดการผู้ใช้งาน / เพิ่มบัญชีใหม่</span>
                </div>
            </div>

            <!-- Add User Graphite Card (16px radius) -->
            <div class="origin-card-graphite p-4 p-md-5">

                <!-- Header -->
                <div class="d-flex align-items-center gap-3 pb-4 mb-4 border-bottom" style="border-color: rgba(255,255,255,0.08) !important;">
                    <div class="origin-pill-chip p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 20px; border-radius: var(--radius-buttons);">
                        ➕
                    </div>
                    <div>
                        <span class="origin-mono" style="color: var(--color-iris-gleam); font-size: 11px;">NEW ACCOUNT CREATION</span>
                        <h3 class="origin-heading-lg mb-1" style="font-size: 26px;">ฟอร์มเพิ่มผู้ใช้งานใหม่</h3>
                        <p class="origin-mono mb-0" style="color: var(--color-ash); font-size: 11px;">กรอกข้อมูลเพื่อสร้างบัญชีเข้าใช้งาน JoJo Hotel Control Portal</p>
                    </div>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="p-3 mb-4 rounded-3 border border-danger-subtle" style="background: rgba(15,16,17,0.7);">
                        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <div class="small text-danger">&times; @error.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-action="AddUser" asp-controller="Admin" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Section: Personal Information -->
                    <span class="origin-mono d-block mb-3" style="color: var(--color-iris-gleam); font-size: 11px;">01 &middot; ข้อมูลส่วนตัว (PERSONAL INFO)</span>

                    <!-- Full Name -->
                    <div class="mb-4">
                        <label asp-for="FullName" class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">ชื่อ - นามสกุล *</label>
                        <input asp-for="FullName" class="origin-input w-100" placeholder="เช่น นายณวรัตน์ อินมีศรี" />
                        <span asp-validation-for="FullName" class="small text-danger"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <!-- Email -->
                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">อีเมลผู้ใช้งาน (EMAIL) *</label>
                            <input asp-for="Email" class="origin-input w-100" placeholder="user@hotel.com" />
                            <span asp-validation-for="Email" class="small text-danger"></span>
                        </div>

                        <!-- Phone Number -->
                        <div class="col-12 col-md-6">
                            <label asp-for="PhoneNumber" class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">เบอร์โทรศัพท์ (TELEPHONE) *</label>
                            <input asp-for="PhoneNumber" class="origin-input w-100" placeholder="08x-xxx-xxxx" />
                            <span asp-validation-for="PhoneNumber" class="small text-danger"></span>
                        </div>
                    </div>

                    <hr class="my-4" style="border-color: rgba(255,255,255,0.08);" />

                    <!-- Section: Role & Account Settings -->
                    <span class="origin-mono d-block mb-3" style="color: var(--color-cyan-signal); font-size: 11px;">02 &middot; การตั้งค่าสิทธิ์และการเข้าถึง (PERMISSIONS &amp; ACCESS)</span>

                    <div class="row g-3 mb-4">
                        <!-- Role -->
                        <div class="col-12 col-md-6">
                            <label asp-for="Role" class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">สิทธิ์ผู้ใช้งาน (ROLE) *</label>
                            <select asp-for="Role" class="origin-input w-100">
                                <option value="User">👤 User (ลูกค้าทั่วไป)</option>
                                <option value="Staff">💼 Staff (เจ้าหน้าที่)</option>
                                <option value="Admin">👑 Admin (ผู้ดูแลระบบ)</option>
                            </select>
                            <span asp-validation-for="Role" class="small text-danger"></span>
                        </div>

                        <!-- Status -->
                        <div class="col-12 col-md-6">
                            <label asp-for="Status" class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">สถานะการใช้งาน (STATUS) *</label>
                            <select asp-for="Status" class="origin-input w-100">
                                <option value="Active">🟢 ใช้งานอยู่ (Active)</option>
                                <option value="Inactive">🔴 ระงับการใช้งาน (Inactive)</option>
                            </select>
                            <span asp-validation-for="Status" class="small text-danger"></span>
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="mb-5">
                        <label asp-for="Password" class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">รหัสผ่านเริ่มต้น (PASSWORD) *</label>
                        <input asp-for="Password" type="password" class="origin-input w-100" placeholder="อย่างน้อย 6 ตัวอักษร" />
                        <span asp-validation-for="Password" class="small text-danger"></span>
                        <div class="origin-mono mt-1" style="color: var(--color-ash); font-size: 10px;">ผู้ใช้สามารถนำรหัสผ่านนี้ไปใช้ล็อกอินเข้าสู่ระบบได้ทันที</div>
                    </div>

                    <!-- Submit & Cancel Buttons -->
                    <div class="pt-3 border-top d-flex justify-content-end gap-2" style="border-color: rgba(255,255,255,0.08) !important;">
                        <a asp-action="Users" asp-controller="Admin" class="btn-origin-ghost py-2 px-4" style="font-size: 13px;">
                            ยกเลิก
                        </a>
                        <button type="submit" class="btn-origin-primary py-2 px-4" style="font-size: 13px;">
                            บันทึกข้อมูลผู้ใช้ &rarr;
                        </button>
                    </div>
                </form>

            </div>

        </div>
    </div>
</div>
