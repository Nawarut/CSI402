@model Nawarut_8250_L005.ViewModels.UserListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "จัดการบัญชีผู้ใช้งาน (User List)";
    var allCount = Model?.Users?.Count ?? 0;
    var renterCount = Model?.Users?.Count(u => u.Role == "Renter" || u.Role == "ผู้เช่า") ?? 0;
    var staffCount = Model?.Users?.Count(u => u.Role == "Staff" || u.Role == "พนักงาน" || u.Role == "Accountant" || u.Role == "Admin" || u.Role == "ผู้ดูแลระบบ") ?? 0;
    var suspendedCount = Model?.Users?.Count(u => u.Status == "Suspended" || u.Status == "ระงับการใช้งาน" || u.Status == "inactive" || u.Status == "locked") ?? 0;
}

<div class="container-fluid px-0">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="origin-card-graphite p-3 mb-4 d-flex justify-content-between align-items-center" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span style="color: var(--color-cyan-signal);">&#x25CF;</span>
                <span class="small text-white">@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-baseline mb-4">
        <div>
            <span class="origin-mono" style="color: var(--color-iris-gleam); font-size: 11px;">USER &amp; ROLE PERMISSIONS</span>
            <h2 class="origin-heading-lg mt-1 mb-0" style="font-size: 30px; font-family: 'Prompt', sans-serif !important;">จัดการบัญชีผู้ใช้งานและกำหนดสิทธิ์</h2>
            <p class="origin-mono mt-1 mb-0" style="color: var(--color-ash); font-size: 11px;">ผู้ใช้งานทั้งหมด @allCount บัญชี &middot; สมาชิกของ JoJo Hotel</p>
        </div>
        <div class="d-flex align-items-center gap-2 mt-3 mt-sm-0">
            <a asp-controller="Admin" asp-action="AddUser" class="btn-origin-primary py-2 px-3 text-decoration-none" style="font-size: 13px;">
                + เพิ่มผู้ใช้งาน &rarr;
            </a>
        </div>
    </div>

    <!-- Stat Cards (Origin Graphite Cards, 16px radius) -->
    <div class="row g-4 mb-5">
        <!-- บัญชีทั้งหมด -->
        <div class="col-6 col-md-3">
            <div class="origin-card-graphite p-4 h-100">
                <span class="origin-mono d-block mb-1" style="color: var(--color-ash); font-size: 11px;">บัญชีทั้งหมด</span>
                <div class="origin-heading-lg mb-0" style="font-size: 34px; color: var(--color-pure);">@allCount</div>
                <span class="origin-mono" style="color: var(--color-cyan-signal); font-size: 10px;">ALL RESIDENTS</span>
            </div>
        </div>

        <!-- บัญชีผู้เช่า / ลูกค้า -->
        <div class="col-6 col-md-3">
            <div class="origin-card-graphite p-4 h-100">
                <span class="origin-mono d-block mb-1" style="color: var(--color-ash); font-size: 11px;">บัญชีผู้เช่า / ลูกค้า</span>
                <div class="origin-heading-lg mb-0" style="font-size: 34px; color: var(--color-iris-gleam);">@renterCount</div>
                <span class="origin-mono" style="color: var(--color-iris-gleam); font-size: 10px;">GUESTS &amp; RENTERS</span>
            </div>
        </div>

        <!-- บัญชีพนักงาน -->
        <div class="col-6 col-md-3">
            <div class="origin-card-graphite p-4 h-100">
                <span class="origin-mono d-block mb-1" style="color: var(--color-ash); font-size: 11px;">บัญชีเจ้าหน้าที่</span>
                <div class="origin-heading-lg mb-0" style="font-size: 34px; color: var(--color-orchid-bloom);">@staffCount</div>
                <span class="origin-mono" style="color: var(--color-orchid-bloom); font-size: 10px;">HOTEL STAFF &amp; ADMIN</span>
            </div>
        </div>

        <!-- บัญชีระงับการใช้งาน -->
        <div class="col-6 col-md-3">
            <div class="origin-card-graphite p-4 h-100">
                <span class="origin-mono d-block mb-1" style="color: var(--color-ash); font-size: 11px;">บัญชีถูกระงับ</span>
                <div class="origin-heading-lg mb-0" style="font-size: 34px; color: #ff6b6b;">@suspendedCount</div>
                <span class="origin-mono" style="color: #ff6b6b; font-size: 10px;">SUSPENDED ACCESS</span>
            </div>
        </div>
    </div>

    <!-- Table Card (Graphite Card, 16px radius, Dark Table) -->
    <div class="origin-card-graphite p-0 overflow-hidden mb-5" style="background-color: var(--color-graphite) !important; border: 1px solid rgba(255,255,255,0.08) !important;">
        <div class="p-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: rgba(255,255,255,0.08) !important;">
            <div>
                <span class="origin-mono" style="color: var(--color-iris-gleam); font-size: 11px;">DIRECTORY</span>
                <h3 class="origin-heading-lg mb-0" style="font-size: 20px; font-family: 'Prompt', sans-serif !important;">รายชื่อผู้ใช้งานทั้งหมด</h3>
            </div>
            <span class="origin-mono" style="color: var(--color-ash); font-size: 11px;">ทั้งหมด @allCount รายการ</span>
        </div>

        <div class="table-responsive" style="background-color: var(--color-abyss) !important;">
            <table class="table origin-table mb-0" style="background-color: transparent !important; color: #ffffff !important;">
                <thead>
                    <tr class="origin-mono" style="border-bottom: 1px solid rgba(255,255,255,0.12) !important; background-color: rgba(15,16,17,0.8) !important; color: var(--color-ash); font-size: 11px;">
                        <th class="p-3">ผู้ใช้งาน</th>
                        <th class="p-3">บทบาท (ROLE)</th>
                        <th class="p-3">ห้องพัก / สล็อต</th>
                        <th class="p-3">สถานะ</th>
                        <th class="p-3 text-end">การจัดการ</th>
                    </tr>
                </thead>
                <tbody style="background-color: transparent !important;">
                    @if (Model?.Users != null && Model.Users.Any())
                    {
                        @foreach (var user in Model.Users)
                        {
                            var rawName = user.FullName;
                            if (string.IsNullOrWhiteSpace(rawName))
                            {
                                rawName = $"{user.Firstname} {user.Lastname}".Trim();
                            }
                            if (string.IsNullOrWhiteSpace(rawName) || rawName == "-")
                            {
                                rawName = user.Email.Contains('@') ? user.Email.Split('@')[0] : "ผู้ใช้งาน";
                            }

                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.06) !important; background-color: transparent !important;">
                                <!-- ผู้ใช้งาน -->
                                <td class="p-3 align-middle" style="background-color: transparent !important;">
                                    <div class="fw-bold" style="color: #ffffff !important; font-size: 14.5px;">
                                        @rawName
                                    </div>
                                    <div class="origin-mono" style="color: var(--color-ash); font-size: 11px;">
                                        <span>@user.Phone</span> &middot; <span>@user.Email</span>
                                    </div>
                                </td>

                                <!-- บทบาท -->
                                <td class="p-3 align-middle" style="background-color: transparent !important;">
                                    @if (user.Role == "Admin" || user.Role == "ผู้ดูแลระบบ")
                                    {
                                        <span class="badge rounded-pill px-3 py-1" style="background: rgba(132,125,255,0.15); border: 1px solid rgba(132,125,255,0.4); color: var(--color-iris-gleam); font-size: 11px;">
                                            👑 Admin
                                        </span>
                                    }
                                    else if (user.Role == "Renter" || user.Role == "ผู้เช่า")
                                    {
                                        <span class="badge rounded-pill px-3 py-1" style="background: rgba(0,179,221,0.15); border: 1px solid rgba(0,179,221,0.4); color: var(--color-cyan-signal); font-size: 11px;">
                                            👤 Renter
                                        </span>
                                    }
                                    else if (user.Role == "Staff" || user.Role == "พนักงาน")
                                    {
                                        <span class="badge rounded-pill px-3 py-1" style="background: rgba(221,144,216,0.15); border: 1px solid rgba(221,144,216,0.4); color: var(--color-orchid-bloom); font-size: 11px;">
                                            💼 Staff
                                        </span>
                                    }
                                    else if (user.Role == "Accountant" || user.Role == "บัญชี")
                                    {
                                        <span class="badge rounded-pill px-3 py-1" style="background: rgba(144,184,240,0.15); border: 1px solid rgba(144,184,240,0.4); color: var(--color-periwinkle); font-size: 11px;">
                                            📊 Accountant
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill px-3 py-1" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); color: var(--color-ash); font-size: 11px;">
                                            @(user.Role ?? "User")
                                        </span>
                                    }
                                </td>

                                <!-- ล็อกซ์ / ห้องที่ -->
                                <td class="p-3 align-middle origin-mono" style="color: var(--color-ash); font-size: 12px; background-color: transparent !important;">
                                    @(string.IsNullOrWhiteSpace(user.SlotNo) ? "—" : user.SlotNo)
                                </td>

                                <!-- สถานะ -->
                                <td class="p-3 align-middle" style="background-color: transparent !important;">
                                    @if (user.Status == "Active" || user.Status == "ปกติ" || user.Status == "active")
                                    {
                                        <span class="origin-mono" style="color: var(--color-cyan-signal); font-size: 11px;">
                                            ● Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="origin-mono" style="color: #ff6b6b; font-size: 11px;">
                                            ● @(user.Status ?? "Inactive")
                                        </span>
                                    }
                                </td>

                                <!-- จัดการ (Visible Action Buttons) -->
                                <td class="p-3 align-middle text-end" style="background-color: transparent !important;">
                                    <div class="d-inline-flex gap-2">
                                        <!-- แก้ไข -->
                                        <button type="button"
                                                onclick="openEditUserModal(this)"
                                                data-userid="@user.UserId"
                                                data-firstname="@user.Firstname"
                                                data-lastname="@user.Lastname"
                                                data-email="@user.Email"
                                                data-phone="@user.Phone"
                                                data-role="@user.Role"
                                                data-status="@user.Status"
                                                class="btn-action-edit">
                                            <i class="bi bi-pencil-square"></i> แก้ไข
                                        </button>

                                        <!-- ลบ -->
                                        <form asp-controller="Home" asp-action="DeleteUser" method="post" class="d-inline" onsubmit="return confirm('คุณแน่ใจหรือไม่ว่าต้องการลบผู้ใช้งานนี้?');">
                                            <input type="hidden" name="id" value="@user.UserId" />
                                            <button type="submit" class="btn-action-delete">
                                                <i class="bi bi-trash3"></i> ลบ
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="p-5 text-center origin-mono" style="color: var(--color-ash); background-color: transparent !important;">
                                ไม่พบข้อมูลผู้ใช้งานในระบบ
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- Modal แก้ไขข้อมูลผู้ใช้ (Origin Glassmorphism Modal) -->
<!-- ========================================== -->
<div id="editUserModal" class="modal-backdrop-origin" style="display: none; position: fixed; inset: 0; z-index: 2000; background: rgba(9,10,11,0.85); backdrop-filter: blur(24px); align-items: center; justify-content: center; padding: 20px;">
    <div class="origin-card-graphite p-4 p-md-5" style="max-width: 560px; width: 100%; max-height: 90vh; overflow-y: auto;">
        
        <!-- Modal Header -->
        <div class="d-flex justify-content-between align-items-start pb-3 mb-4 border-bottom" style="border-color: rgba(255,255,255,0.08) !important;">
            <div>
                <span class="origin-pill-chip mb-2">CRUD: UPDATE</span>
                <h3 class="origin-heading-lg mb-1" style="font-size: 24px;">แก้ไขข้อมูลผู้ใช้งาน</h3>
                <p class="origin-mono mb-0" style="color: var(--color-ash); font-size: 11px;">แก้ไขข้อมูลและบันทึกลงฐานข้อมูล JoJo Hotel ทันที</p>
            </div>
            <button type="button" onclick="closeEditUserModal()" class="btn-close btn-close-white"></button>
        </div>

        <!-- Form Edit User -->
        <form asp-controller="Home" asp-action="EditUser" method="post">
            <input type="hidden" id="modalUserId" name="UserId" />

            <!-- User ID & Email (Readonly) -->
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label class="origin-mono d-block mb-1" style="color: var(--color-ash); font-size: 11px;">รหัสผู้ใช้ (USER ID)</label>
                    <input type="text" id="modalUserIdDisplay" readonly class="origin-input w-100 opacity-75" style="cursor: not-allowed;" />
                </div>
                <div class="col-6">
                    <label class="origin-mono d-block mb-1" style="color: var(--color-ash); font-size: 11px;">อีเมล (EMAIL)</label>
                    <input type="email" id="modalEmail" name="Email" readonly class="origin-input w-100 opacity-75" style="cursor: not-allowed;" />
                </div>
            </div>

            <!-- ชื่อ & นามสกุล -->
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label class="origin-mono d-block mb-1" style="color: var(--color-ash); font-size: 11px;">ชื่อ *</label>
                    <input type="text" id="modalFirstname" name="Firstname" required class="origin-input w-100" />
                </div>
                <div class="col-6">
                    <label class="origin-mono d-block mb-1" style="color: var(--color-ash); font-size: 11px;">นามสกุล *</label>
                    <input type="text" id="modalLastname" name="Lastname" required class="origin-input w-100" />
                </div>
            </div>

            <!-- เบอร์โทรศัพท์ -->
            <div class="mb-3">
                <label class="origin-mono d-block mb-1" style="color: var(--color-ash); font-size: 11px;">เบอร์โทรศัพท์</label>
                <input type="tel" id="modalPhone" name="Phone" class="origin-input w-100" />
            </div>

            <!-- บทบาท & สถานะ -->
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label class="origin-mono d-block mb-1" style="color: var(--color-ash); font-size: 11px;">บทบาท (ROLE)</label>
                    <select id="modalRole" name="Role" class="origin-input w-100">
                        <option value="Admin">Admin (ผู้ดูแลระบบ)</option>
                        <option value="Staff">Staff (พนักงาน)</option>
                        <option value="Accountant">Accountant (บัญชี)</option>
                        <option value="Renter">Renter (ผู้เช่า)</option>
                        <option value="Guest">Guest (ผู้เยี่ยมชม)</option>
                    </select>
                </div>
                <div class="col-6">
                    <label class="origin-mono d-block mb-1" style="color: var(--color-ash); font-size: 11px;">สถานะ (STATUS)</label>
                    <select id="modalStatus" name="Status" class="origin-input w-100">
                        <option value="active">Active (ใช้งานได้ปกติ)</option>
                        <option value="inactive">Inactive (ระงับการใช้งาน)</option>
                        <option value="locked">Locked (ล็อกการใช้งาน)</option>
                    </select>
                </div>
            </div>

            <!-- รหัสผ่านใหม่ (ถ้าต้องการเปลี่ยน) -->
            <div class="mb-4">
                <label class="origin-mono d-block mb-1" style="color: var(--color-ash); font-size: 11px;">รหัสผ่านใหม่ (เว้นว่างไว้หากไม่ต้องการเปลี่ยน)</label>
                <input type="password" name="Password" placeholder="ระบุรหัสผ่านใหม่เมื่อต้องการเปลี่ยน" class="origin-input w-100" />
            </div>

            <!-- Buttons -->
            <div class="pt-3 border-top d-flex justify-content-end gap-2" style="border-color: rgba(255,255,255,0.08) !important;">
                <button type="button" onclick="closeEditUserModal()" class="btn-origin-ghost py-2 px-3" style="font-size: 13px;">
                    ยกเลิก
                </button>
                <button type="submit" class="btn-origin-primary py-2 px-4" style="font-size: 13px;">
                    บันทึกการแก้ไข &rarr;
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openEditUserModal(btn) {
        document.getElementById('modalUserId').value = btn.dataset.userid || '';
        document.getElementById('modalUserIdDisplay').value = btn.dataset.userid || '';
        document.getElementById('modalFirstname').value = btn.dataset.firstname || '';
        document.getElementById('modalLastname').value = btn.dataset.lastname || '';
        document.getElementById('modalEmail').value = btn.dataset.email || '';
        document.getElementById('modalPhone').value = btn.dataset.phone === '-' ? '' : (btn.dataset.phone || '');
        
        const roleSelect = document.getElementById('modalRole');
        if (roleSelect && btn.dataset.role) {
            roleSelect.value = btn.dataset.role;
        }

        const statusSelect = document.getElementById('modalStatus');
        if (statusSelect && btn.dataset.status) {
            statusSelect.value = btn.dataset.status.toLowerCase();
        }

        const modal = document.getElementById('editUserModal');
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closeEditUserModal() {
        const modal = document.getElementById('editUserModal');
        modal.style.display = 'none';
        document.body.style.overflow = '';
    }

    document.getElementById('editUserModal')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closeEditUserModal();
        }
    });
</script>
