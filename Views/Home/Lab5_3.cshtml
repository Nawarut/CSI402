@model Nawarut_8250_L005.ViewModels.UserListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "จัดการบัญชีผู้ใช้งาน (User List)";
    var allCount = Model?.Users?.Count ?? 0;
    var renterCount = Model?.Users?.Count(u => u.Role == "Renter" || u.Role == "ผู้เช่า") ?? 0;
    var staffCount = Model?.Users?.Count(u => u.Role == "Staff" || u.Role == "พนักงาน" || u.Role == "Accountant" || u.Role == "Admin" || u.Role == "ผู้ดูแลระบบ") ?? 0;
    var suspendedCount = Model?.Users?.Count(u => u.Status == "Suspended" || u.Status == "ระงับการใช้งาน") ?? 0;
}

<section class="w-full">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 rounded-lg bg-emerald-50 p-4 text-sm text-emerald-800 border border-emerald-200 flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        </div>
    }

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
            <p class="text-xs font-semibold text-emerald-700 uppercase tracking-wider">USER & ROLE PERMISSION</p>
            <h1 class="text-2xl font-bold text-slate-900 mt-1">จัดการบัญชีผู้ใช้งานและกำหนดสิทธิ์</h1>
            <p class="text-xs text-slate-500 mt-0.5">ผู้ใช้งานทั้งหมด @allCount บัญชี</p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-controller="Home" asp-action="Lab5_2" class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-emerald-800 hover:bg-emerald-700 text-white text-sm font-semibold transition shadow-sm">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                เพิ่มผู้ใช้งาน
            </a>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <!-- บัญชีทั้งหมด -->
        <div class="bg-white rounded-xl p-5 border border-slate-200/80 shadow-sm">
            <p class="text-xs font-medium text-slate-500">บัญชีทั้งหมด</p>
            <h3 class="text-2xl font-bold text-slate-900 mt-2">@allCount</h3>
        </div>

        <!-- บัญชีผู้เช่า -->
        <div class="bg-white rounded-xl p-5 border border-slate-200/80 shadow-sm">
            <p class="text-xs font-medium text-slate-500">บัญชีผู้เช่า</p>
            <h3 class="text-2xl font-bold text-slate-900 mt-2">@renterCount</h3>
        </div>

        <!-- บัญชีพนักงาน -->
        <div class="bg-white rounded-xl p-5 border border-slate-200/80 shadow-sm">
            <p class="text-xs font-medium text-slate-500">บัญชีพนักงาน</p>
            <h3 class="text-2xl font-bold text-slate-900 mt-2">@staffCount</h3>
        </div>

        <!-- บัญชีถูกระงับ -->
        <div class="bg-white rounded-xl p-5 border border-slate-200/80 shadow-sm">
            <p class="text-xs font-medium text-rose-500">บัญชีถูกระงับ</p>
            <h3 class="text-2xl font-bold text-rose-600 mt-2">@suspendedCount</h3>
        </div>
    </div>

    <!-- Table Card -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-100 flex items-center justify-between">
            <h2 class="text-base font-bold text-slate-900">รายชื่อผู้ใช้งาน</h2>
            <span class="text-xs text-slate-500">ทั้งหมด @allCount รายการ</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/50">
                        <th class="py-3.5 px-6 text-xs font-semibold text-slate-500">ผู้ใช้งาน</th>
                        <th class="py-3.5 px-6 text-xs font-semibold text-slate-500">บทบาท</th>
                        <th class="py-3.5 px-6 text-xs font-semibold text-slate-500">ล็อกซ์ / ห้องที่</th>
                        <th class="py-3.5 px-6 text-xs font-semibold text-slate-500">สถานะ</th>
                        <th class="py-3.5 px-6 text-xs font-semibold text-slate-500 text-right">จัดการ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model?.Users != null && Model.Users.Any())
                    {
                        @foreach (var user in Model.Users)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <!-- ผู้ใช้งาน -->
                                <td class="py-4 px-6">
                                    <div class="font-semibold text-slate-900 text-sm">
                                        @(string.IsNullOrWhiteSpace(user.FullName) ? $"{user.Firstname} {user.Lastname}" : user.FullName)
                                    </div>
                                    <div class="text-xs text-slate-400 mt-0.5 flex items-center gap-1.5">
                                        <span>@user.Phone</span>
                                        <span>•</span>
                                        <span>@user.Email</span>
                                    </div>
                                </td>

                                <!-- บทบาท -->
                                <td class="py-4 px-6">
                                    @if (user.Role == "Admin" || user.Role == "ผู้ดูแลระบบ")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-50 text-purple-700 border border-purple-200">
                                            Admin
                                        </span>
                                    }
                                    else if (user.Role == "Renter" || user.Role == "ผู้เช่า")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-cyan-50 text-cyan-700 border border-cyan-200">
                                            Renter
                                        </span>
                                    }
                                    else if (user.Role == "Staff" || user.Role == "พนักงาน")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            Staff
                                        </span>
                                    }
                                    else if (user.Role == "Accountant" || user.Role == "บัญชี")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-teal-50 text-teal-700 border border-teal-200">
                                            Accountant
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
                                            @(user.Role ?? "User")
                                        </span>
                                    }
                                </td>

                                <!-- ล็อกซ์ / ห้องที่ -->
                                <td class="py-4 px-6 text-sm text-slate-600">
                                    @(string.IsNullOrWhiteSpace(user.SlotNo) ? "-" : user.SlotNo)
                                </td>

                                <!-- สถานะ -->
                                <td class="py-4 px-6">
                                    @if (user.Status == "Active" || user.Status == "ปกติ")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-rose-50 text-rose-700 border border-rose-200">
                                            <span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span>
                                            @(user.Status ?? "Inactive")
                                        </span>
                                    }
                                </td>

                                <!-- จัดการ (Edit & Delete - รวมในหน้ารายชื่อโดยตรง) -->
                                <td class="py-4 px-6 text-right">
                                    <div class="inline-flex items-center gap-1.5 justify-end">
                                        <!-- แก้ไข (Edit - เปิด Modal ในหน้านี้โดยตรง) -->
                                        <button type="button"
                                                onclick="openEditUserModal(this)"
                                                data-userid="@user.UserId"
                                                data-firstname="@user.Firstname"
                                                data-lastname="@user.Lastname"
                                                data-email="@user.Email"
                                                data-phone="@user.Phone"
                                                data-role="@user.Role"
                                                data-status="@user.Status"
                                                class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-amber-50 text-amber-700 hover:bg-amber-100 border border-amber-200 transition shadow-sm cursor-pointer">
                                            <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                            </svg>
                                            แก้ไข
                                        </button>

                                        <!-- ลบ (Delete - Lab 10_1) -->
                                        <form asp-controller="Home" asp-action="DeleteUser" method="post" class="inline" onsubmit="return confirm('คุณแน่ใจหรือไม่ว่าต้องการลบผู้ใช้งานนี้?');">
                                            <input type="hidden" name="id" value="@user.UserId" />
                                            <button type="submit" class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200 transition cursor-pointer">
                                                <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                                ลบ
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="py-8 text-center text-sm text-slate-400">
                                ไม่พบข้อมูลผู้ใช้งาน
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- ========================================== -->
<!-- Modal แก้ไขข้อมูลผู้ใช้ (Inline Edit User Modal) -->
<!-- ========================================== -->
<div id="editUserModal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="relative w-full max-w-lg rounded-2xl bg-white p-6 shadow-2xl border border-slate-100 transition-all sm:p-8">
        <!-- Modal Header -->
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200">
                    CRUD: UPDATE
                </span>
                <h3 class="text-xl font-bold text-slate-900 mt-1">แก้ไขข้อมูลผู้ใช้งาน</h3>
                <p class="text-xs text-slate-500">แก้ไขข้อมูลและบันทึกลงฐานข้อมูลได้ทันทีในหน้านี้</p>
            </div>
            <button type="button" onclick="closeEditUserModal()" class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Form Edit User -->
        <form asp-controller="Home" asp-action="EditUser" method="post" class="mt-5 space-y-4">
            <input type="hidden" id="modalUserId" name="UserId" />

            <!-- User ID & Email (Readonly) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">รหัสผู้ใช้ (User ID)</label>
                    <input type="text" id="modalUserIdDisplay" readonly class="h-10 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-xs text-slate-500 font-mono cursor-not-allowed" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">อีเมล (บัญชีผู้ใช้)</label>
                    <input type="email" id="modalEmail" name="Email" readonly class="h-10 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-xs text-slate-500 font-mono cursor-not-allowed" />
                </div>
            </div>

            <!-- ชื่อ & นามสกุล -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-slate-700 mb-1">ชื่อ <span class="text-rose-500">*</span></label>
                    <input type="text" id="modalFirstname" name="Firstname" required class="h-10 w-full rounded-lg border border-slate-300 px-3 text-sm focus:border-emerald-700 focus:outline-none focus:ring-1 focus:ring-emerald-700" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-700 mb-1">นามสกุล <span class="text-rose-500">*</span></label>
                    <input type="text" id="modalLastname" name="Lastname" required class="h-10 w-full rounded-lg border border-slate-300 px-3 text-sm focus:border-emerald-700 focus:outline-none focus:ring-1 focus:ring-emerald-700" />
                </div>
            </div>

            <!-- เบอร์โทรศัพท์ -->
            <div>
                <label class="block text-xs font-medium text-slate-700 mb-1">เบอร์โทรศัพท์</label>
                <input type="tel" id="modalPhone" name="Phone" class="h-10 w-full rounded-lg border border-slate-300 px-3 text-sm focus:border-emerald-700 focus:outline-none focus:ring-1 focus:ring-emerald-700" />
            </div>

            <!-- บทบาท & สถานะ -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-slate-700 mb-1">บทบาท (Role)</label>
                    <select id="modalRole" name="Role" class="h-10 w-full rounded-lg border border-slate-300 px-3 text-sm focus:border-emerald-700 focus:outline-none focus:ring-1 focus:ring-emerald-700 bg-white">
                        <option value="Admin">Admin (ผู้ดูแลระบบ)</option>
                        <option value="Staff">Staff (พนักงาน)</option>
                        <option value="Accountant">Accountant (บัญชี)</option>
                        <option value="Renter">Renter (ผู้เช่า)</option>
                        <option value="Guest">Guest (ผู้เยี่ยมชม)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-700 mb-1">สถานะ (Status)</label>
                    <select id="modalStatus" name="Status" class="h-10 w-full rounded-lg border border-slate-300 px-3 text-sm focus:border-emerald-700 focus:outline-none focus:ring-1 focus:ring-emerald-700 bg-white">
                        <option value="active">Active (ใช้งานได้ปกติ)</option>
                        <option value="inactive">Inactive (ระงับการใช้งาน)</option>
                        <option value="locked">Locked (ล็อกการใช้งาน)</option>
                    </select>
                </div>
            </div>

            <!-- รหัสผ่านใหม่ (ถ้าต้องการเปลี่ยน) -->
            <div>
                <label class="block text-xs font-medium text-slate-700 mb-1">รหัสผ่านใหม่ (เว้นว่างไว้หากไม่ต้องการเปลี่ยน)</label>
                <input type="password" name="Password" placeholder="ระบุรหัสผ่านใหม่เมื่อต้องการเปลี่ยน" class="h-10 w-full rounded-lg border border-slate-300 px-3 text-sm focus:border-emerald-700 focus:outline-none focus:ring-1 focus:ring-emerald-700" />
            </div>

            <!-- ปุ่มดำเนินการ -->
            <div class="pt-3 flex items-center justify-end gap-3 border-t border-slate-100">
                <button type="button" onclick="closeEditUserModal()" class="h-10 px-4 rounded-lg border border-slate-200 text-sm font-medium text-slate-600 hover:bg-slate-50 transition cursor-pointer">
                    ยกเลิก
                </button>
                <button type="submit" class="h-10 px-5 rounded-lg bg-emerald-800 text-sm font-semibold text-white hover:bg-emerald-700 active:bg-emerald-900 transition shadow flex items-center cursor-pointer">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    บันทึกการแก้ไข
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openEditUserModal(btn) {
        document.getElementById('modalUserId').value = btn.dataset.userid || '';
        document.getElementById('modalUserIdDisplay').value = btn.dataset.userid || '';
        document.getElementById('modalFirstname').value = btn.dataset.firstname || '';
        document.getElementById('modalLastname').value = btn.dataset.lastname || '';
        document.getElementById('modalEmail').value = btn.dataset.email || '';
        document.getElementById('modalPhone').value = btn.dataset.phone === '-' ? '' : (btn.dataset.phone || '');
        
        const roleSelect = document.getElementById('modalRole');
        if (roleSelect && btn.dataset.role) {
            roleSelect.value = btn.dataset.role;
        }

        const statusSelect = document.getElementById('modalStatus');
        if (statusSelect && btn.dataset.status) {
            statusSelect.value = btn.dataset.status.toLowerCase();
        }

        const modal = document.getElementById('editUserModal');
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeEditUserModal() {
        const modal = document.getElementById('editUserModal');
        modal.classList.add('hidden');
        document.body.style.overflow = '';
    }

    document.getElementById('editUserModal')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closeEditUserModal();
        }
    });
</script>