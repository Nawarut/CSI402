@model List<Nawarut_8250_L005.Entities.Room>
@{
    ViewData["Title"] = "หน้าหลัก";
    Layout = "_navbarlayout";
    var userName = Context.Session.GetString("UserName");
    var userRole = Context.Session.GetString("UserRole");
    var checkInVal = ViewBag.CheckIn as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var checkOutVal = ViewBag.CheckOut as string ?? DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
    var destVal = ViewBag.Destination as string ?? "";
    int adultsVal = ViewBag.Adults is int a ? a : 2;
    int childrenVal = ViewBag.Children is int c ? c : 0;
}

<!-- ==========================================
     HERO SECTION (ORIGIN NOCTURNAL GALLERY)
     Centered Lyon Display 80-96px weight 300 with mixed italic word
     Subhead in 18px weight 300 Ash (#9f9fa0)
========================================== -->
<section class="py-5 text-center position-relative overflow-hidden">
    <div class="container py-4" style="max-width: 1200px;">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="origin-card-graphite p-4 mb-4 mx-auto text-start" style="max-width: 720px; border: 1px solid rgba(0,179,221,0.4) !important;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="origin-pill-chip" style="background: rgba(0,179,221,0.15); color: var(--color-cyan-signal); border-color: rgba(0,179,221,0.4);">
                        ✓ BOOKING &amp; DEPOSIT CONFIRMED
                    </span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
                <div class="fw-bold fs-5 text-white mb-2">
                    @TempData["SuccessMessage"]
                </div>
                @if (TempData["BookingConfirmedCode"] != null)
                {
                    <div class="row g-2 mt-2 pt-2 border-top" style="border-color: rgba(255,255,255,0.08) !important;">
                        <div class="col-4">
                            <span class="origin-mono" style="font-size: 10px; color: var(--color-ash);">รหัสการจอง:</span>
                            <div class="origin-mono fw-bold text-white">@TempData["BookingConfirmedCode"]</div>
                        </div>
                        <div class="col-4">
                            <span class="origin-mono" style="font-size: 10px; color: var(--color-cyan-signal);">มัดจำล่วงหน้า 5%:</span>
                            <div class="fw-bold" style="color: var(--color-cyan-signal);">฿@TempData["DepositAmount"]</div>
                        </div>
                        <div class="col-4">
                            <span class="origin-mono" style="font-size: 10px; color: var(--color-ash);">คงเหลือชำระวันเช็คอิน:</span>
                            <div class="fw-bold text-white">฿@TempData["RemainingAmount"]</div>
                        </div>
                    </div>
                    <div class="mt-3 pt-2 border-top d-flex justify-content-end" style="border-color: rgba(255,255,255,0.08) !important;">
                        <a asp-controller="Account" asp-action="BookingHistory" class="btn-origin-glass" style="font-size: 13px; padding: 7px 16px;">
                            <i class="bi bi-clipboard-check me-1" aria-hidden="true"></i> ดูประวัติการจอง &rarr;
                        </a>
                    </div>
                }
            </div>
        }

        <!-- Pill Chip Eyebrow Badge -->
        <div class="mb-4">
            <span class="origin-pill-chip">
                ★ JOJO LUXURY RESORT &middot; CURATED ART OF HOSPITALITY
            </span>
        </div>

        <!-- Monumental Serif Display Headline: 80-96px weight 300 with italic word -->
        <h1 class="origin-display mb-4">
            <em>สัมผัส</em> ประสบการณ์การพักผ่อนเหนือระดับ
        </h1>

        <!-- Subhead: 18px weight 300 in Ash -->
        <p class="origin-subhead mx-auto mb-5" style="max-width: 640px;">
            ยินดีต้อนรับสู่ โจโจ้ ทราเวล แอนด์ โฮเทล รีสอร์ทหรูระดับ 5 ดาว 
            ที่ซึ่งสถาปัตยกรรมและความสงบเงียบถูกรังสรรค์ให้เป็นดั่งผลงานศิลปะชิ้นเอก
        </p>

        @if (!string.IsNullOrEmpty(userName))
        {
            <div class="origin-card-graphite text-start mx-auto mb-5 p-4 d-flex flex-wrap justify-content-between align-items-center gap-3" style="max-width: 700px;">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-hand-thumbs-up fs-2" aria-hidden="true"></i>
                    <div>
                        <div class="fw-bold mb-0 text-white">สวัสดีคุณ @userName</div>
                        <span class="origin-mono" style="color: var(--color-iris-gleam); font-size: 11px;">
                            สถานะสมาชิก: @userRole &middot; เข้าสู่ระบบเรียบร้อยแล้ว
                        </span>
                    </div>
                </div>
                @if (userRole == "Admin")
                {
                    <a asp-controller="Admin" asp-action="Index" class="btn-origin-primary py-2 px-3 text-decoration-none" style="font-size: 13px;">
                        แผงควบคุม Admin &rarr;
                    </a>
                }
            </div>
        }

    </div>
</section>

<!-- ==========================================
     SEARCH BAR WIDGET (Origin Dark Elevated Panel)
     ช่องกรอกชื่อที่พัก/จังหวัด, วันเช็คอิน-เช็คเอาท์, จำนวนห้อง/ผู้ใหญ่/เด็ก
========================================== -->
<section class="container pb-5" style="max-width: 1200px;">
    <div class="p-4 p-md-5" style="background-color: var(--color-void); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: var(--radius-cards); box-shadow: var(--shadow-origin-lg);">
        
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <span class="origin-mono" style="color: var(--color-cloud);">
                <i class="bi bi-search me-1" aria-hidden="true"></i> ค้นหาห้องพักและจุดหมายปลายทาง
            </span>
            <span class="origin-mono" style="color: var(--color-cyan-signal); font-size: 11px;">
                เวลาเช็คอิน 09:00 น. &middot; เช็คเอาท์ 12:00 น.
            </span>
        </div>

        <form method="get" asp-controller="Home" asp-action="Index">
            <div class="row g-3 align-items-end">

                <!-- 1. ค้นหาห้อง / ชั้น / ประเภทห้อง -->
                <div class="col-12 col-md-3">
                    <label class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;"><i class="bi bi-geo-alt me-1" aria-hidden="true"></i> ค้นหาห้องพัก / เลขห้อง / ชั้น</label>
                    <input type="text"
                           name="destination"
                           value="@destVal"
                           class="origin-input w-100"
                           placeholder="เช่น 1101, Deluxe, Suite, ชั้น 12" />
                </div>

                <!-- 2. วันที่เช็คอิน (09:00 น.) -->
                <div class="col-6 col-md-2">
                    <label class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;"><i class="bi bi-calendar3 me-1" aria-hidden="true"></i> เช็คอิน (09:00)</label>
                    <input type="date"
                           name="checkIn"
                           class="origin-input w-100"
                           value="@checkInVal" />
                </div>

                <!-- 3. วันที่เช็คเอาท์ (12:00 น.) -->
                <div class="col-6 col-md-2">
                    <label class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;"><i class="bi bi-calendar3 me-1" aria-hidden="true"></i> เช็คเอาท์ (12:00)</label>
                    <input type="date"
                           name="checkOut"
                           class="origin-input w-100"
                           value="@checkOutVal" />
                </div>

                <!-- 4. จำนวนผู้ใหญ่ -->
                <div class="col-6 col-md-2">
                    <label class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;"><i class="bi bi-people me-1" aria-hidden="true"></i> ผู้ใหญ่</label>
                    <select name="adults" class="origin-input w-100">
                        @for (int i = 1; i <= 8; i++)
                        {
                            <option value="@i" selected="@(adultsVal == i ? "selected" : null)">@i ท่าน</option>
                        }
                    </select>
                </div>

                <!-- 5. จำนวนเด็ก -->
                <div class="col-6 col-md-1">
                    <label class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;"><i class="bi bi-person me-1" aria-hidden="true"></i> เด็ก</label>
                    <select name="children" class="origin-input w-100">
                        @for (int i = 0; i <= 4; i++)
                        {
                            <option value="@i" selected="@(childrenVal == i ? "selected" : null)">@i ท่าน</option>
                        }
                    </select>
                </div>

                <!-- 6. ปุ่มค้นหา -->
                <div class="col-12 col-md-2">
                    <button type="submit" class="btn-origin-primary w-100 justify-content-center">
                        ค้นหาห้องพัก &rarr;
                    </button>
                </div>

            </div>
        </form>

    </div>
</section>

<!-- ==========================================
     PROMOTIONS (CHROMATIC CATEGORY TILES)
     Origin 30px radius full-bleed saturated panels:
     Iris Gleam (#847dff), Orchid Bloom (#dd90d8), Deep Iris (#4b49aa)
========================================== -->
<section class="container pb-5 my-4" style="max-width: 1200px;">
    
    <div class="d-flex justify-content-between align-items-baseline mb-4">
        <div>
            <span class="origin-mono d-block" style="color: var(--color-iris-gleam);">CURATED PRIVILEGES</span>
            <h2 class="origin-heading-lg mt-1 mb-0">แบนเนอร์โปรโมชั่นพิเศษ</h2>
        </div>
        <span class="origin-mono" style="color: var(--color-fog);">SEASONAL OFFERS &rarr;</span>
    </div>

    <div class="row g-4">

        <!-- Promo 1: Iris Gleam Tile (#847dff) -->
        <div class="col-12 col-md-4">
            <div class="origin-tile-iris h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="badge bg-white text-dark rounded-pill px-3 py-1 fw-bold" style="font-size: 11px;">
                            <i class="bi bi-lightning-charge me-1" aria-hidden="true"></i> ลด 25%
                        </span>
                        <span class="origin-mono text-white-50" style="font-size: 11px;">CODE: ADVANCE30</span>
                    </div>
                    <h3 class="origin-heading-lg mb-2" style="font-size: 32px;">จองล่วงหน้า 30 วัน</h3>
                    <p class="mb-4" style="color: rgba(255,255,255,0.85); font-size: 15px; line-height: 1.6;">
                        จองห้องพักล่วงหน้าอย่างน้อย 30 วัน รับส่วนลดพิเศษทันที 25% สำหรับห้องพักทุกประเภท
                    </p>
                </div>
                <div class="pt-3 border-top border-white-50 d-flex justify-content-between align-items-center">
                    <span class="origin-mono text-white" style="font-size: 11px;">ถึง 31 ธ.ค. 2569</span>
                    <span class="fs-5">&rarr;</span>
                </div>
            </div>
        </div>

        <!-- Promo 2: Orchid Bloom Tile (#dd90d8) -->
        <div class="col-12 col-md-4">
            <div class="origin-tile-orchid h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="badge bg-white text-dark rounded-pill px-3 py-1 fw-bold" style="font-size: 11px;">
                            <i class="bi bi-stars me-1" aria-hidden="true"></i> สมาชิกใหม่
                        </span>
                        <span class="origin-mono text-white-50" style="font-size: 11px;">CODE: NEWMEMBER10</span>
                    </div>
                    <h3 class="origin-heading-lg mb-2" style="font-size: 32px;">สมาชิกใหม่จองครั้งแรก</h3>
                    <p class="mb-4" style="color: rgba(255,255,255,0.85); font-size: 15px; line-height: 1.6;">
                        สมัครสมาชิกวันนี้ รับส่วนลด 10% สำหรับการจองครั้งแรก พร้อมการันตีชำระมัดจำล่วงหน้าเพียง 5%
                    </p>
                </div>
                <div class="pt-3 border-top border-white-50 d-flex justify-content-between align-items-center">
                    <span class="origin-mono text-white" style="font-size: 11px;">ไม่มีวันหมดอายุ</span>
                    <span class="fs-5">&rarr;</span>
                </div>
            </div>
        </div>

        <!-- Promo 3: Deep Iris Tile (#4b49aa) -->
        <div class="col-12 col-md-4">
            <div class="origin-tile-deep-iris h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="badge bg-white text-dark rounded-pill px-3 py-1 fw-bold" style="font-size: 11px;">
                            <i class="bi bi-moon-stars me-1" aria-hidden="true"></i> พักผ่อนยาว
                        </span>
                        <span class="origin-mono text-white-50" style="font-size: 11px;">CODE: STAY2NIGHTS15</span>
                    </div>
                    <h3 class="origin-heading-lg mb-2" style="font-size: 32px;">เข้าพัก 2 คืนขึ้นไป</h3>
                    <p class="mb-4" style="color: rgba(255,255,255,0.85); font-size: 15px; line-height: 1.6;">
                        เข้าพักต่อเนื่องตั้งแต่ 2 คืนขึ้นไป รับส่วนลดพิเศษ 15% พร้อมเช็คอิน 09:00 น. และเช็คเอาท์ 12:00 น.
                    </p>
                </div>
                <div class="pt-3 border-top border-white-50 d-flex justify-content-between align-items-center">
                    <span class="origin-mono text-white" style="font-size: 11px;">ถึง 28 ก.พ. 2570</span>
                    <span class="fs-5">&rarr;</span>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- ==========================================
     RECOMMENDED ROOMS & HOTEL SUITES
     Origin Gallery Wall: Elevated Graphite Cards (16px radius)
     Atmospheric photography, Cyan Signal data indicators
========================================== -->
<section class="container pb-5 my-5" style="max-width: 1200px;" id="recommended-rooms">
    
    <div class="d-flex justify-content-between align-items-baseline mb-4">
        <div>
            <span class="origin-mono d-block" style="color: var(--color-cyan-signal);">CURATED SUITES</span>
            <h2 class="origin-heading-lg mt-1 mb-0">รายการห้องพักของโรงแรม (ข้อมูลจริง)</h2>
        </div>
        <span class="origin-mono" style="color: var(--color-cloud);">
            ทั้งหมด @(Model?.Count ?? 0) ห้องพัก &middot; เช็คอิน 09:00 น. | เช็คเอาท์ 12:00 น.
        </span>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var room in Model)
            {
                var typeName = room.RoomType?.TypeName ?? "Luxury Suite";
                var price = room.PricePerNight ?? room.RoomType?.BasePrice ?? 3500m;
                var isAvailable = (room.Status ?? "").ToLower() is "available" or "ว่าง";
                var statusText = room.Status?.ToLower() switch
                {
                    "available" or "ว่าง" => "ว่างพร้อมพัก",
                    "reserved" or "จองแล้ว" => "จองแล้ว",
                    "occupied" or "มีผู้เข้าพัก" => "มีผู้เข้าพัก",
                    "cleaning" or "กำลังทำความสะอาด" => "กำลังทำความสะอาด",
                    "maintenance" or "ซ่อมบำรุง" => "ซ่อมบำรุง",
                    _ => room.Status ?? "ว่าง"
                };
                var statusBadgeStyle = room.Status?.ToLower() switch
                {
                    "available" or "ว่าง" => "border-color: var(--color-cyan-signal); color: var(--color-cyan-signal); background: rgba(0,179,221,0.15);",
                    "reserved" or "จองแล้ว" => "border-color: #fcd34d; color: #fcd34d; background: rgba(252,211,77,0.15);",
                    "occupied" or "มีผู้เข้าพัก" => "border-color: #ef4444; color: #ef4444; background: rgba(239,68,68,0.15);",
                    "cleaning" or "กำลังทำความสะอาด" => "border-color: #f59e0b; color: #f59e0b; background: rgba(245,158,11,0.15);",
                    _ => "border-color: var(--color-ash); color: var(--color-ash); background: rgba(255,255,255,0.08);"
                };

                // เลือกรูปภาพห้องพัก
                string imgUrl = room.RoomType?.RoomImages?.FirstOrDefault()?.ImageUrl ?? "";
                if (string.IsNullOrWhiteSpace(imgUrl))
                {
                    if (typeName.Contains("Executive", StringComparison.OrdinalIgnoreCase) || (room.FloorNo == 11))
                        imgUrl = "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80";
                    else if (typeName.Contains("Deluxe", StringComparison.OrdinalIgnoreCase) || (room.FloorNo == 12))
                        imgUrl = "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=800&q=80";
                    else if (typeName.Contains("Ocean", StringComparison.OrdinalIgnoreCase) || (room.FloorNo == 13))
                        imgUrl = "https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=800&q=80";
                    else if (typeName.Contains("Family", StringComparison.OrdinalIgnoreCase) || (room.FloorNo == 14))
                        imgUrl = "https://images.unsplash.com/photo-1540541338287-41700207dee6?auto=format&fit=crop&w=800&q=80";
                    else
                        imgUrl = "https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=800&q=80";
                }

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="origin-card-graphite h-100 p-0 overflow-hidden d-flex flex-column justify-content-between">
                        <div>
                            <div class="position-relative overflow-hidden" style="height: 240px;">
                                <img src="@imgUrl"
                                     alt="ห้อง @room.RoomNumber"
                                     style="width: 100%; height: 100%; object-fit: cover;" />
                                <span class="position-absolute top-0 start-0 m-3 origin-pill-chip" style="background: rgba(15,16,17,0.88);">
                                    ห้อง #@room.RoomNumber &middot; ชั้น @(room.FloorNo ?? 1)
                                </span>
                                <span class="position-absolute bottom-0 end-0 m-3 badge rounded-pill px-3 py-1 fw-bold border" style="@statusBadgeStyle font-size: 11px;">
                                    ● @statusText
                                </span>
                            </div>
                            <div class="p-4">
                                <div class="d-flex justify-content-between align-items-baseline mb-2">
                                    <h3 class="origin-heading-lg mb-0" style="font-size: 22px;">@typeName</h3>
                                    <span class="origin-mono fw-bold" style="color: var(--color-cyan-signal); font-size: 15px;">
                                        ฿@price.ToString("N0") <span style="font-size:10px; color:var(--color-ash);">/ คืน</span>
                                    </span>
                                </div>
                                <p class="origin-body mb-3" style="font-size: 13px; color: var(--color-ash);">
                                    เตียง @(room.RoomType?.BedType ?? "King Bed") &middot; @(room.RoomType?.SizeSqm ?? 45) ตร.ม. &middot; สูงสุด @(room.RoomType?.MaxGuests ?? 2) ท่าน &middot; มัดจำ 5% (฿@((price * 0.05m).ToString("N0")))
                                </p>
                            </div>
                        </div>
                        <div class="px-4 pb-4 pt-2 border-top d-flex justify-content-between align-items-center" style="border-color: rgba(255,255,255,0.08) !important;">
                            <span class="origin-mono" style="font-size: 11px; color: var(--color-ash);">เช็คอิน 09:00 | เช็คเอาท์ 12:00</span>
                            <a asp-controller="Room" asp-action="Details"
                               asp-route-id="@room.RoomId"
                               asp-route-checkIn="@checkInVal"
                               asp-route-checkOut="@checkOutVal"
                               asp-route-adults="@adultsVal"
                               asp-route-children="@childrenVal"
                               class="@(isAvailable ? "btn-origin-primary" : "btn-origin-ghost")"
                               style="padding: 8px 16px; font-size: 13px;">
                                @(isAvailable ? "จองเลย →" : "ดูห้องพัก →")
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 py-5 text-center">
                <div class="origin-card-graphite p-5 mx-auto" style="max-width: 600px;">
                    <i class="bi bi-search fs-1 mb-3" aria-hidden="true"></i>
                    <h3 class="origin-heading-lg mb-2">ไม่พบห้องพักตามเงื่อนไขที่ค้นหา</h3>
                    <p class="origin-body text-muted mb-4">ลองปรับเปลี่ยนคำค้นหา หรือกดรีเซ็ตเพื่อแสดงห้องพักทั้งหมด</p>
                    <a asp-action="Index" class="btn-origin-primary py-2 px-4 text-decoration-none">แสดงห้องพักทั้งหมด &rarr;</a>
                </div>
            </div>
        }
    </div>

</section>
