@{
    ViewData["Title"] = "หน้าหลัก";
    Layout = "_navbarlayout";
    var userName = Context.Session.GetString("UserName");
    var userRole = Context.Session.GetString("UserRole");
}

<!-- ==========================================
     HERO SECTION (ORIGIN NOCTURNAL GALLERY)
     Centered Lyon Display 80-96px weight 300 with mixed italic word
     Subhead in 18px weight 300 Ash (#9f9fa0)
========================================== -->
<section class="py-5 text-center position-relative overflow-hidden">
    <div class="container py-4" style="max-width: 1200px;">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="origin-card-graphite p-4 mb-4 mx-auto text-start" style="max-width: 720px; border: 1px solid rgba(0,179,221,0.4) !important;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="origin-pill-chip" style="background: rgba(0,179,221,0.15); color: var(--color-cyan-signal); border-color: rgba(0,179,221,0.4);">
                        ✓ BOOKING &amp; DEPOSIT CONFIRMED
                    </span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
                <div class="fw-bold fs-5 text-white mb-2">
                    @TempData["SuccessMessage"]
                </div>
                @if (TempData["BookingConfirmedCode"] != null)
                {
                    <div class="row g-2 mt-2 pt-2 border-top" style="border-color: rgba(255,255,255,0.08) !important;">
                        <div class="col-4">
                            <span class="origin-mono" style="font-size: 10px; color: var(--color-ash);">รหัสการจอง:</span>
                            <div class="origin-mono fw-bold text-white">@TempData["BookingConfirmedCode"]</div>
                        </div>
                        <div class="col-4">
                            <span class="origin-mono" style="font-size: 10px; color: var(--color-cyan-signal);">มัดจำล่วงหน้า 5%:</span>
                            <div class="fw-bold" style="color: var(--color-cyan-signal);">฿@TempData["DepositAmount"]</div>
                        </div>
                        <div class="col-4">
                            <span class="origin-mono" style="font-size: 10px; color: var(--color-ash);">คงเหลือชำระวันเช็คอิน:</span>
                            <div class="fw-bold text-white">฿@TempData["RemainingAmount"]</div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Pill Chip Eyebrow Badge -->
        <div class="mb-4">
            <span class="origin-pill-chip">
                ★ JOJO LUXURY RESORT &middot; CURATED ART OF HOSPITALITY
            </span>
        </div>

        <!-- Monumental Serif Display Headline: 80-96px weight 300 with italic word -->
        <h1 class="origin-display mb-4">
            <em>สัมผัส</em> ประสบการณ์การพักผ่อนเหนือระดับ
        </h1>

        <!-- Subhead: 18px weight 300 in Ash -->
        <p class="origin-subhead mx-auto mb-5" style="max-width: 640px;">
            ยินดีต้อนรับสู่ โจโจ้ ทราเวล แอนด์ โฮเทล รีสอร์ทหรูระดับ 5 ดาว 
            ที่ซึ่งสถาปัตยกรรมและความสงบเงียบถูกรังสรรค์ให้เป็นดั่งผลงานศิลปะชิ้นเอก
        </p>

        @if (!string.IsNullOrEmpty(userName))
        {
            <div class="origin-card-graphite text-start mx-auto mb-5 p-4 d-flex flex-wrap justify-content-between align-items-center gap-3" style="max-width: 700px;">
                <div class="d-flex align-items-center gap-3">
                    <span class="fs-2">👋</span>
                    <div>
                        <div class="fw-bold mb-0 text-white">สวัสดีคุณ @userName</div>
                        <span class="origin-mono" style="color: var(--color-iris-gleam); font-size: 11px;">
                            สถานะสมาชิก: @userRole &middot; เข้าสู่ระบบเรียบร้อยแล้ว
                        </span>
                    </div>
                </div>
                @if (userRole == "Admin")
                {
                    <a asp-controller="Admin" asp-action="Index" class="btn-origin-primary py-2 px-3 text-decoration-none" style="font-size: 13px;">
                        แผงควบคุม Admin &rarr;
                    </a>
                }
            </div>
        }

    </div>
</section>

<!-- ==========================================
     SEARCH BAR WIDGET (Origin Dark Elevated Panel)
     ช่องกรอกชื่อที่พัก/จังหวัด, วันเช็คอิน-เช็คเอาท์, จำนวนห้อง/ผู้ใหญ่/เด็ก
========================================== -->
<section class="container pb-5" style="max-width: 1200px;">
    <div class="p-4 p-md-5" style="background-color: var(--color-void); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: var(--radius-cards); box-shadow: var(--shadow-origin-lg);">
        
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <span class="origin-mono" style="color: var(--color-cloud);">
                🔍 ค้นหาห้องพักและจุดหมายปลายทาง
            </span>
            <span class="origin-mono" style="color: var(--color-cyan-signal); font-size: 11px;">
                เวลาเช็คอิน 09:00 น. &middot; เช็คเอาท์ 12:00 น.
            </span>
        </div>

        <form method="get" action="#">
            <div class="row g-3 align-items-end">

                <!-- 1. ชื่อที่พัก / จังหวัด -->
                <div class="col-12 col-md-3">
                    <label class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">📍 จุดหมาย / จังหวัด</label>
                    <input type="text"
                           name="destination"
                           class="origin-input w-100"
                           placeholder="เช่น ภูเก็ต, เชียงใหม่, พัทยา" />
                </div>

                <!-- 2. วันที่เช็คอิน (09:00 น.) -->
                <div class="col-6 col-md-2">
                    <label class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">📅 เช็คอิน (09:00)</label>
                    <input type="date"
                           name="checkIn"
                           class="origin-input w-100"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>

                <!-- 3. วันที่เช็คเอาท์ (12:00 น.) -->
                <div class="col-6 col-md-2">
                    <label class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">📅 เช็คเอาท์ (12:00)</label>
                    <input type="date"
                           name="checkOut"
                           class="origin-input w-100"
                           value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                </div>

                <!-- 4. จำนวนห้อง -->
                <div class="col-4 col-md-1">
                    <label class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">🛏 ห้อง</label>
                    <select name="rooms" class="origin-input w-100">
                        @for (int i = 1; i <= 6; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>

                <!-- 5. จำนวนผู้ใหญ่ -->
                <div class="col-4 col-md-1">
                    <label class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">👨‍👩 ผู้ใหญ่</label>
                    <select name="adults" class="origin-input w-100">
                        @for (int i = 1; i <= 8; i++)
                        {
                            <option value="@i" selected="@(i == 2 ? "selected" : null)">@i</option>
                        }
                    </select>
                </div>

                <!-- 6. จำนวนเด็ก -->
                <div class="col-4 col-md-1">
                    <label class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">👶 เด็ก</label>
                    <select name="children" class="origin-input w-100">
                        @for (int i = 0; i <= 4; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>

                <!-- 7. ปุ่มค้นหา (White-on-Black Primary CTA Button with →) -->
                <div class="col-12 col-md-2">
                    <button type="button"
                            class="btn-origin-primary w-100 justify-content-center"
                            onclick="document.getElementById('recommended-rooms').scrollIntoView({ behavior: 'smooth' });">
                        ค้นหาห้องพัก &rarr;
                    </button>
                </div>

            </div>
        </form>

    </div>
</section>

