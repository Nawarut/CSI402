@{
    ViewData["Title"] = "หน้าหลัก";
    Layout = "_navbarlayout";
    var userName = Context.Session.GetString("UserName");
    var userRole = Context.Session.GetString("UserRole");
}

<div class="hero-section text-center text-dark py-5 px-3">
    <div class="container py-4">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4 mx-auto" style="max-width: 700px;" role="alert">
                <div class="d-flex align-items-center justify-content-center">
                    <span class="fs-4 me-2">🎉</span>
                    <div>@TempData["SuccessMessage"]</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-semibold mb-3">
            ✨ JoJo TRAVEL & HOTEL LUXURY RESORT
        </span>
        <h1 class="display-4 fw-bold mb-3">
            สัมผัสประสบการณ์การพักผ่อนเหนือระดับ
        </h1>
        <p class="lead text-muted mx-auto mb-4" style="max-width: 650px;">
            ยินดีต้อนรับสู่ โจโจ้ ทราเวล แอนด์ โฮเทล รีสอร์ทหรูระดับ 5 ดาว พร้อมบริการห้องพัก อาหารเลิศรส และการดูแลระดับพรีเมียม
        </p>

        @if (!string.IsNullOrEmpty(userName))
        {
            <div class="user-greeting-card bg-white p-4 rounded-4 shadow-sm mx-auto mb-4" style="max-width: 600px; border-left: 5px solid #f2b400;">
                <div class="d-flex align-items-center gap-3 text-start">
                    <div class="fs-1">👋</div>
                    <div>
                        <h5 class="fw-bold mb-1">สวัสดีคุณ @userName !</h5>
                        <p class="text-muted small mb-0">สถานะสมาชิก: <span class="badge bg-primary-subtle text-primary">@userRole</span> เข้าสู่ระบบเรียบร้อยแล้ว พร้อมรับส่วนลดพิเศษสำหรับการจองวันนี้</p>
                    </div>
                </div>
                @if (userRole == "Admin")
                {
                    <div class="mt-3 pt-3 border-top text-end">
                        <a asp-controller="Admin" asp-action="Users" class="btn btn-warning fw-bold rounded-pill px-4">
                            👑 เข้าสู่ระบบจัดการ Admin Panel (User List) →
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="d-flex justify-content-center gap-3 mb-5">
                <a asp-controller="Account" asp-action="Login" class="btn btn-warning fw-bold px-4 py-2 rounded-pill shadow-sm">
                    🔑 เข้าสู่ระบบ
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-dark fw-bold px-4 py-2 rounded-pill">
                    📝 สมัครสมาชิกใหม่
                </a>
            </div>
        }

        <!-- Booking Search Widget Preview -->
        <div class="search-widget card border-0 shadow-lg rounded-4 p-4 mx-auto text-start" style="max-width: 900px;">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-bold text-muted">📍 จุดหมายปลายทาง</label>
                    <input type="text" class="form-control" value="JoJo Grand Beach Resort" readonly />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold text-muted">📅 วันที่เช็คอิน</label>
                    <input type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold text-muted">📅 วันที่เช็คเอาท์</label>
                    <input type="date" class="form-control" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-md-3">
                    <button class="btn btn-warning w-100 fw-bold py-2 rounded-3 text-dark" onclick="alert('ค้นหาห้องพักว่างสำเร็จ!')">
                        🔍 ค้นหาห้องพัก
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .hero-section {
        background: radial-gradient(circle at center, #fffbf0 0%, #ffffff 100%);
    }

    .search-widget {
        background: #ffffff;
        border: 1px solid #f1ece1;
    }
</style>
