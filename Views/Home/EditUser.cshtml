@model Nawarut_8250_L005.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = "แก้ไขข้อมูลผู้ใช้งาน";
}

<section class="mx-auto max-w-2xl px-4 py-10">
    <div class="rounded-2xl bg-white p-6 shadow-lg shadow-slate-900/5 sm:p-10 border border-slate-100">
        <!-- Header -->
        <div class="flex items-center justify-between pb-6 border-b border-slate-100">
            <div>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200">
                    CRUD: UPDATE
                </span>
                <h1 class="mt-2 text-2xl font-bold text-slate-900">แก้ไขข้อมูลผู้ใช้งาน</h1>
                <p class="text-xs text-slate-500 mt-1">ประยุกต์ใช้หลักการแก้ไขข้อมูลจาก Lab 10</p>
            </div>
            <a asp-action="Lab5_3" asp-controller="Home" class="inline-flex items-center text-sm font-medium text-slate-500 hover:text-slate-800 transition">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                กลับหน้ารายชื่อ
            </a>
        </div>

        <!-- Form Edit User (แบบเดียวกับ Lab 10) -->
        <form asp-controller="Home" asp-action="EditUser" method="post" class="mt-6 grid gap-4 sm:grid-cols-2">
            <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600 sm:col-span-2"></div>

            <!-- User ID (Readonly แบบเดียวกับ StdId ใน Lab 10) -->
            <label class="block sm:col-span-2">
                <span class="mb-1.5 block text-sm font-medium text-slate-700">รหัสผู้ใช้งาน (User ID)</span>
                <input asp-for="UserId" type="text" readonly
                       class="h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm text-slate-500 font-mono cursor-not-allowed" />
                <span class="text-xs text-slate-400 mt-1 block">* รหัสผู้ใช้ถูกล็อกไว้ไม่สามารถแก้ไขได้ (Primary Key)</span>
            </label>

            <!-- ชื่อ -->
            <label class="block">
                <span class="mb-1.5 block text-sm font-medium text-slate-700">ชื่อ</span>
                <input asp-for="Firstname" class="h-11 w-full rounded-lg border border-slate-300 px-3 text-sm focus:border-emerald-700 focus:outline-none focus:ring-1 focus:ring-emerald-700 transition" />
                <span asp-validation-for="Firstname" class="text-sm text-rose-600"></span>
            </label>

            <!-- นามสกุล -->
            <label class="block">
                <span class="mb-1.5 block text-sm font-medium text-slate-700">นามสกุล</span>
                <input asp-for="Lastname" class="h-11 w-full rounded-lg border border-slate-300 px-3 text-sm focus:border-emerald-700 focus:outline-none focus:ring-1 focus:ring-emerald-700 transition" />
                <span asp-validation-for="Lastname" class="text-sm text-rose-600"></span>
            </label>

            <!-- อีเมล (Readonly หรือแก้ไขได้) -->
            <label class="block sm:col-span-2">
                <span class="mb-1.5 block text-sm font-medium text-slate-700">อีเมล (บัญชีผู้ใช้)</span>
                <input asp-for="Email" type="email" readonly
                       class="h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm text-slate-500 font-mono cursor-not-allowed" />
                <span class="text-xs text-slate-400 mt-1 block">* อีเมลใช้เป็นบัญชีเข้าสู่ระบบ</span>
            </label>

            <!-- เบอร์โทรศัพท์ -->
            <label class="block sm:col-span-2">
                <span class="mb-1.5 block text-sm font-medium text-slate-700">เบอร์โทรศัพท์</span>
                <input asp-for="Phone" type="tel"
                       class="h-11 w-full rounded-lg border border-slate-300 px-3 text-sm focus:border-emerald-700 focus:outline-none focus:ring-1 focus:ring-emerald-700 transition" />
                <span asp-validation-for="Phone" class="text-sm text-rose-600"></span>
            </label>

            <!-- บทบาท (Role) -->
            <label class="block">
                <span class="mb-1.5 block text-sm font-medium text-slate-700">บทบาท (Role)</span>
                <select asp-for="Role" class="h-11 w-full rounded-lg border border-slate-300 px-3 text-sm focus:border-emerald-700 focus:outline-none focus:ring-1 focus:ring-emerald-700 bg-white transition">
                    <option value="Admin">Admin (ผู้ดูแลระบบ)</option>
                    <option value="Staff">Staff (พนักงาน)</option>
                    <option value="Accountant">Accountant (บัญชี)</option>
                    <option value="Renter">Renter (ผู้เช่า)</option>
                    <option value="Guest">Guest (ผู้เยี่ยมชม)</option>
                </select>
                <span asp-validation-for="Role" class="text-sm text-rose-600"></span>
            </label>

            <!-- สถานะ (Status) -->
            <label class="block">
                <span class="mb-1.5 block text-sm font-medium text-slate-700">สถานะ (Status)</span>
                <select asp-for="Status" class="h-11 w-full rounded-lg border border-slate-300 px-3 text-sm focus:border-emerald-700 focus:outline-none focus:ring-1 focus:ring-emerald-700 bg-white transition">
                    <option value="active">Active (ใช้งานได้ปกติ)</option>
                    <option value="inactive">Inactive (ระงับการใช้งาน)</option>
                    <option value="locked">Locked (ล็อกการใช้งาน)</option>
                </select>
                <span asp-validation-for="Status" class="text-sm text-rose-600"></span>
            </label>

            <!-- รหัสผ่าน (ถ้าต้องการเปลี่ยน) -->
            <label class="block sm:col-span-2">
                <span class="mb-1.5 block text-sm font-medium text-slate-700">รหัสผ่านใหม่ (ระบุเมื่อต้องการเปลี่ยนรหัสผ่าน)</span>
                <input asp-for="Password" type="password" placeholder="ปล่อยว่างไว้หากไม่ต้องการเปลี่ยนรหัสผ่าน"
                       class="h-11 w-full rounded-lg border border-slate-300 px-3 text-sm focus:border-emerald-700 focus:outline-none focus:ring-1 focus:ring-emerald-700 transition" />
                <span asp-validation-for="Password" class="text-sm text-rose-600"></span>
            </label>

            @if (ViewBag.Error != null)
            {
                <div class="rounded-lg bg-rose-50 p-3 text-sm text-rose-600 sm:col-span-2 border border-rose-200">
                    @ViewBag.Error
                </div>
            }

            <!-- ปุ่มดำเนินการ -->
            <div class="mt-4 flex items-center justify-end gap-3 sm:col-span-2">
                <a asp-action="Lab5_3" asp-controller="Home"
                   class="h-11 px-5 rounded-lg border border-slate-200 text-sm font-medium text-slate-600 hover:bg-slate-50 transition flex items-center">
                    ยกเลิก
                </a>
                <button type="submit"
                        class="h-11 px-6 rounded-lg bg-emerald-800 text-sm font-semibold text-white hover:bg-emerald-700 active:bg-emerald-900 transition shadow flex items-center">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    บันทึกการแก้ไข (Update)
                </button>
            </div>
        </form>
    </div>
</section>
