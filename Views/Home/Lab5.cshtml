@model Nawarut_8250_L005.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<section class="mx-auto max-w-lg px-4 py-10">
    <div class="rounded-2xl bg-white p-6 shadow-lg shadow-slate-900/5 sm:p-10 border border-slate-100">
        <div class="text-center">
            <p class="text-sm font-semibold text-emerald-700 tracking-wider">LOGIN</p>
            <h1 class="mt-1 text-2xl font-bold text-slate-900">เข้าสู่ระบบ</h1>
        </div>

        <form asp-controller="Home" asp-action="Lab5" method="post" class="mt-8 grid gap-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>

            @if (ViewBag.Error != null)
            {
                <div class="rounded-lg bg-rose-50 p-3 text-sm text-rose-600 border border-rose-200">
                    @ViewBag.Error
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="rounded-lg bg-emerald-50 p-3 text-sm text-emerald-700 border border-emerald-200">
                    @TempData["SuccessMessage"]
                </div>
            }

            <label class="block">
                <span class="mb-1.5 block text-sm font-medium text-slate-700">อีเมล</span>
                <input asp-for="Email" type="email" placeholder="name@example.com"
                       class="h-11 w-full rounded-lg border border-slate-300 px-3 text-sm focus:border-emerald-700 focus:outline-none focus:ring-1 focus:ring-emerald-700 transition" />
                <span asp-validation-for="Email" class="text-sm text-rose-600"></span>
            </label>

            <label class="block">
                <span class="mb-1.5 block text-sm font-medium text-slate-700">รหัสผ่าน</span>
                <input asp-for="Password" type="password" placeholder="••••••••"
                       class="h-11 w-full rounded-lg border border-slate-300 px-3 text-sm focus:border-emerald-700 focus:outline-none focus:ring-1 focus:ring-emerald-700 transition" />
                <span asp-validation-for="Password" class="text-sm text-rose-600"></span>
            </label>

            <button type="submit" class="mt-2 h-11 w-full rounded-lg bg-emerald-800 text-sm font-semibold text-white hover:bg-emerald-700 active:bg-emerald-900 transition shadow">
                เข้าสู่ระบบ
            </button>
        </form>

        <p class="mt-6 text-center text-sm text-slate-600">
            ยังไม่มีบัญชี
            <a asp-controller="Home" asp-action="Lab5_2" class="font-semibold text-emerald-700 hover:underline">สมัครสมาชิก</a>
        </p>
    </div>
</section>