@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] — JoJo Hotel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Google Fonts: DM Serif Display & Inter & Roboto Mono & Prompt -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600&family=Prompt:wght@300;400;500;600&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* ========================================================
           ORIGIN STICKY TOP NAVIGATION BAR (GLASSMORPHISM)
           backdrop-filter: blur(24px), rgba(15,16,17,0.75)
        ======================================================== */
        .origin-navbar {
            width: 100%;
            background-color: rgba(15, 16, 17, 0.78);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .origin-navbar-inner {
            max-width: var(--page-max-width, 1200px);
            margin: 0 auto;
            padding: 0 24px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        /* Brand Logo: JoJo Hotel in refined typography */
        .origin-brand {
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 7px;
            flex: 0 0 auto;
        }

        .origin-brand-title {
            font-family: var(--font-serif-display);
            font-size: 21px;
            font-weight: 400;
            color: var(--color-pure);
            letter-spacing: -0.01em;
            line-height: 1;
        }

        .origin-brand-badge {
            font-family: var(--font-roboto-mono);
            font-size: 8px;
            font-weight: 500;
            background: rgba(132, 125, 255, 0.15);
            color: var(--color-iris-gleam);
            border: 1px solid rgba(132, 125, 255, 0.3);
            border-radius: var(--radius-pill);
            padding: 2px 5px;
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        /* Nav links */
        .origin-nav-menu {
            display: flex;
            flex: 1 1 auto;
            min-width: 0;
            flex-wrap: nowrap;
            align-items: center;
            justify-content: space-evenly;
            gap: 2px;
        }

        .origin-nav-menu > * {
            flex: 0 0 auto;
        }

        .origin-nav-link {
            font-family: var(--font-sans-ui);
            font-size: 13px;
            font-weight: 400;
            color: var(--color-ash);
            text-decoration: none;
            padding: 6px 5px;
            border-radius: var(--radius-buttons);
            transition: all 0.2s ease;
            background: transparent;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            white-space: nowrap;
        }

        .origin-nav-link:hover {
            color: var(--color-pure);
            background-color: rgba(255, 255, 255, 0.05);
        }

        /* Dropdown: ห้องพักแยกตามจังหวัด */
        .origin-dropdown {
            position: relative;
        }

        .origin-dropdown-menu {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            min-width: 680px;
            background-color: rgba(15, 16, 17, 0.96);
            backdrop-filter: blur(28px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: var(--radius-cards);
            padding: 28px;
            box-shadow: var(--shadow-origin-lg);
            z-index: 2000;
        }

        .origin-dropdown:hover .origin-dropdown-menu {
            display: block;
        }

        .origin-dropdown-col-title {
            font-family: var(--font-roboto-mono);
            font-size: 11px;
            font-weight: 500;
            color: var(--color-iris-gleam);
            letter-spacing: 0.12em;
            text-transform: uppercase;
            padding-bottom: 6px;
            margin-bottom: 8px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .origin-dropdown-room {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 7px 0;
            text-decoration: none;
            color: var(--color-cloud);
            font-size: 13.5px;
            transition: all 0.15s ease;
        }

        .origin-dropdown-room:hover {
            color: var(--color-pure);
            padding-left: 4px;
        }

        .origin-tag-mini {
            font-family: var(--font-roboto-mono);
            font-size: 9px;
            padding: 2px 6px;
            border-radius: var(--radius-buttons);
            background: rgba(255, 255, 255, 0.06);
            color: var(--color-ash);
        }

        /* Right actions */
        .origin-nav-right {
            display: flex;
            align-items: center;
            flex: 0 1 auto;
            min-width: 0;
            gap: 6px;
            white-space: nowrap;
        }

        .origin-nav-right > .origin-mono {
            display: inline-block;
            max-width: 90px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .origin-nav-right > a {
            flex: 0 0 auto;
            white-space: nowrap;
        }

        .origin-nav-right .btn-origin-glass,
        .origin-nav-right .btn-origin-ghost {
            font-size: 10px !important;
            padding: 6px 9px !important;
        }

        /* Footer */
        .origin-footer {
            background-color: var(--color-abyss);
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            padding: 80px 0 50px 0;
            margin-top: 100px;
        }

        .notification-bell { position: relative; }
        .notification-bell-button {
            position: relative; width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center;
            color: var(--color-cloud); background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.14);
            border-radius: 50%; font-size: 17px;
        }
        .notification-bell-button:hover { color: var(--color-cyan-signal); border-color: rgba(0,179,221,.5); }
        .notification-bell-count {
            position: absolute; top: -5px; right: -5px; min-width: 17px; height: 17px; padding: 0 4px;
            border-radius: 99px; background: #ef4444; color: white; font: 10px/17px var(--font-roboto-mono); text-align: center;
        }
        .notification-bell-menu { width: min(360px, calc(100vw - 24px)); background: var(--color-graphite); border: 1px solid rgba(255,255,255,.12); box-shadow: 0 18px 50px rgba(0,0,0,.4); }
        .notification-bell-list { max-height: 380px; overflow-y: auto; }
        .notification-bell-item { display: flex; gap: 10px; padding: 12px 14px; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,.06); }
        .notification-bell-item:hover { background: rgba(255,255,255,.05); }
        .notification-bell-item.is-read { opacity: .68; }
        .notification-bell-dot { flex: 0 0 8px; width: 8px; height: 8px; margin-top: 6px; border-radius: 50%; background: var(--color-cyan-signal); }
        .notification-bell-item.is-read .notification-bell-dot { background: #64748b; }

        @@media (max-width: 992px) {
            .origin-navbar-inner {
                display: flex;
                height: auto;
                padding: 16px 20px;
                flex-wrap: wrap;
            }
            .origin-nav-menu {
                width: 100%;
                flex: 0 0 100%;
                order: 3;
                margin-top: 14px;
                flex-direction: column;
                align-items: flex-start;
                flex-wrap: wrap;
                gap: 8px;
            }
            .origin-dropdown-menu {
                position: static;
                min-width: 100%;
                box-shadow: none;
                padding: 16px 0;
            }
        }
    </style>
</head>

<body>

    <!-- ==========================================
         ORIGIN STICKY TOP NAVIGATION BAR
    ========================================== -->
    <header class="origin-navbar">
        <div class="origin-navbar-inner">

            <!-- Brand Logo -->
            <a class="origin-brand" asp-controller="Home" asp-action="Index">
                <span class="origin-brand-title">JoJo Hotel</span>
                <span class="origin-brand-badge">RESIDENCES</span>
            </a>

            <!-- Navigation Links -->
            <nav class="origin-nav-menu">
                <a asp-controller="Home" asp-action="Index" class="origin-nav-link">
                    หน้าหลัก
                </a>

                <!-- Dropdown ห้องพัก แยกตามประเภทห้องและชั้น -->
                <div class="origin-dropdown">
                    <span class="origin-nav-link">
                        ห้องพัก <span style="font-size: 11px;">&#x25BE;</span>
                    </span>
                    <div class="origin-dropdown-menu" style="min-width: 600px;">
                        <div class="row g-4">
                            <!-- ชั้น 11: Executive Business Suite -->
                            <div class="col-6">
                                <div class="origin-dropdown-col-title"><i class="bi bi-building me-1" aria-hidden="true"></i> EXECUTIVE BUSINESS SUITE (ชั้น 11)</div>
                                <a asp-controller="Room" asp-action="Details" asp-route-id="1101" class="origin-dropdown-room">
                                    <span>ห้อง #1101 (King Bed)</span>
                                    <span class="origin-tag-mini">฿3,900 / คืน</span>
                                </a>
                                <a asp-controller="Room" asp-action="Details" asp-route-id="1102" class="origin-dropdown-room">
                                    <span>ห้อง #1102 (King Bed)</span>
                                    <span class="origin-tag-mini">฿3,900 / คืน</span>
                                </a>
                            </div>

                            <!-- ชั้น 12: Deluxe King Suite -->
                            <div class="col-6">
                                <div class="origin-dropdown-col-title" style="color: var(--color-cyan-signal);"><i class="bi bi-gem me-1" aria-hidden="true"></i> DELUXE KING SUITE (ชั้น 12)</div>
                                <a asp-controller="Room" asp-action="Details" asp-route-id="1201" class="origin-dropdown-room">
                                    <span>ห้อง #1201 (King Bed)</span>
                                    <span class="origin-tag-mini">฿4,200 / คืน</span>
                                </a>
                                <a asp-controller="Room" asp-action="Details" asp-route-id="1202" class="origin-dropdown-room">
                                    <span>ห้อง #1202 (King Bed)</span>
                                    <span class="origin-tag-mini">฿4,200 / คืน</span>
                                </a>
                            </div>

                            <!-- ชั้น 13: Ocean View Balcony Suite -->
                            <div class="col-6">
                                <div class="origin-dropdown-col-title" style="color: var(--color-orchid-bloom);"><i class="bi bi-water me-1" aria-hidden="true"></i> OCEAN VIEW BALCONY (ชั้น 13)</div>
                                <a asp-controller="Room" asp-action="Details" asp-route-id="1301" class="origin-dropdown-room">
                                    <span>ห้อง #1301 (Balcony)</span>
                                    <span class="origin-tag-mini">฿4,800 / คืน</span>
                                </a>
                                <a asp-controller="Room" asp-action="Details" asp-route-id="1302" class="origin-dropdown-room">
                                    <span>ห้อง #1302 (Balcony)</span>
                                    <span class="origin-tag-mini">฿4,800 / คืน</span>
                                </a>
                            </div>

                            <!-- ชั้น 14: Grand Family Suite -->
                            <div class="col-6">
                                <div class="origin-dropdown-col-title" style="color: var(--color-periwinkle);"><i class="bi bi-people me-1" aria-hidden="true"></i> GRAND FAMILY SUITE (ชั้น 14)</div>
                                <a asp-controller="Room" asp-action="Details" asp-route-id="1401" class="origin-dropdown-room">
                                    <span>ห้อง #1401 (Family 4 ท่าน)</span>
                                    <span class="origin-tag-mini">฿5,800 / คืน</span>
                                </a>
                                <a asp-controller="Room" asp-action="Details" asp-route-id="1402" class="origin-dropdown-room">
                                    <span>ห้อง #1402 (Family 4 ท่าน)</span>
                                    <span class="origin-tag-mini">฿5,800 / คืน</span>
                                </a>
                            </div>
                        </div>
                        <div class="border-top pt-3 mt-3 d-flex justify-content-between align-items-center" style="border-color: rgba(255,255,255,0.08) !important;">
                            <span class="origin-mono" style="font-size: 11px; color: var(--color-ash);">เช็คอิน: 09:00 น. &middot; เช็คเอาท์: 12:00 น.</span>
                            <a asp-controller="Home" asp-action="Index" class="origin-mono text-decoration-none" style="color: var(--color-cyan-signal); font-size: 11px;">
                                ดูห้องพักทั้งหมด &rarr;
                            </a>
                        </div>
                    </div>
                </div>

                <a asp-controller="Account" asp-action="BookingHistory" class="origin-nav-link">
                    ประวัติการจอง
                </a>

                <a asp-controller="Account" asp-action="Support" class="origin-nav-link">
                    แจ้งปัญหา / Customer Service
                </a>

                <a href="#" class="origin-nav-link" onclick="alert('ติดต่อฝ่ายต้อนรับ: +66 (0) 2 123 4567'); return false;">
                    ติดต่อเรา
                </a>
            </nav>

            <!-- Right Actions: Login & Logout buttons -->
            <div class="origin-nav-right">
                @await Component.InvokeAsync("NotificationBell")
                @if (!string.IsNullOrEmpty(Context.Session.GetString("UserName")))
                {
                    <span class="origin-mono" style="font-size: 11px; color: var(--color-ash);">
                        &middot; @Context.Session.GetString("UserName")
                    </span>
                    @if (Context.Session.GetString("UserRole") == "Admin")
                    {
                        <a asp-controller="Admin" asp-action="Index" class="btn-origin-glass" style="font-size: 12px; padding: 6px 12px;">
                            <i class="bi bi-shield-lock me-1" aria-hidden="true"></i> ADMIN PANEL
                        </a>
                    }
                    else if (Context.Session.GetString("UserRole") == "Staff" || Context.Session.GetString("UserRole") == "Reception")
                    {
                        <a asp-controller="Reception" asp-action="Index" class="btn-origin-glass" style="font-size: 12px; padding: 6px 12px; color: var(--color-cyan-signal); border-color: rgba(0,179,221,0.3);">
                            <i class="bi bi-bell me-1" aria-hidden="true"></i> RECEPTION
                        </a>
                    }
                    else if (Context.Session.GetString("UserRole") == "Accountant" || Context.Session.GetString("UserRole") == "Accounting")
                    {
                        <a asp-controller="Accounting" asp-action="Index" class="btn-origin-glass" style="font-size: 12px; padding: 6px 12px; color: var(--color-orchid-bloom); border-color: rgba(221,144,216,0.3);">
                            <i class="bi bi-wallet2 me-1" aria-hidden="true"></i> ACCOUNTING
                        </a>
                    }
                    else if (Context.Session.GetString("UserRole") == "CustomerService" || Context.Session.GetString("UserRole") == "Support")
                    {
                        <a asp-controller="CustomerService" asp-action="Index" class="btn-origin-glass" style="font-size: 12px; padding: 6px 12px; color: var(--color-periwinkle); border-color: rgba(144,184,240,0.3);">
                            <i class="bi bi-headset me-1" aria-hidden="true"></i> CUSTOMER SERVICE
                        </a>
                    }
                    <a asp-controller="Account" asp-action="Logout" class="btn-origin-ghost" style="font-size: 13px; padding: 7px 16px;">
                        ออกจากระบบ
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="origin-nav-link text-white" style="font-size: 14px;">
                        เข้าสู่ระบบ
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn-origin-primary" style="font-size: 14px; padding: 9px 18px;">
                        สมัครสมาชิก &rarr;
                    </a>
                }
            </div>

        </div>
    </header>

    <!-- ==========================================
         PAGE CONTENT
    ========================================== -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- ==========================================
         ORIGIN EDITORIAL FOOTER
         Nocturnal gallery palette: Abyss & Obsidian
    ========================================== -->
    <footer class="origin-footer">
        <div class="container" style="max-width: 1200px;">
            <div class="row g-5 mb-5">
                <div class="col-12 col-md-5">
                    <div class="origin-brand-title mb-2">JoJo Hotel &middot; Residences</div>
                    <p class="origin-body mb-0" style="max-width: 400px;">
                        A nocturnal gallery of quiet hospitality. Oversized serif whispers and luminous chromatic sanctuaries across Thailand.
                    </p>
                </div>
                <div class="col-6 col-md-3">
                    <div class="origin-mono mb-3" style="color: var(--color-cloud);">DESTINATIONS</div>
                    <ul class="list-unstyled d-flex flex-column gap-2" style="font-size: 14px; color: var(--color-ash);">
                        <li>Bangkok Sanctuary</li>
                        <li>Chiang Mai Highlands</li>
                        <li>Phuket Coastline</li>
                        <li>Hua Hin Villa</li>
                        <li>Koh Samui Island</li>
                    </ul>
                </div>
                <div class="col-6 col-md-4">
                    <div class="origin-mono mb-3" style="color: var(--color-cloud);">SCHEDULE STANDARDS</div>
                    <ul class="list-unstyled d-flex flex-column gap-2" style="font-size: 14px; color: var(--color-ash);">
                        <li><span style="color:var(--color-cyan-signal);">&#x25CF;</span> เช็คอิน (Check-in): 09:00 น.</li>
                        <li><span style="color:var(--color-orchid-bloom);">&#x25CF;</span> เช็คเอาท์ (Check-out): 12:00 น.</li>
                        <li>Concierge Service: +66 (0) 2 123 4567</li>
                    </ul>
                </div>
            </div>

            <div class="pt-4 border-top d-flex flex-wrap justify-content-between align-items-center" style="border-color: rgba(255,255,255,0.08) !important;">
                <span class="origin-mono" style="font-size: 11px; color: var(--color-fog);">&copy; @DateTime.Now.Year JoJo Hotel. All Rights Reserved.</span>
                <span class="origin-mono" style="font-size: 11px; color: var(--color-iris-gleam);">CURATED ART OF HOSPITALITY</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
