@model Nawarut_8250_L005.ViewModels.NotificationBellViewModel
<style>
    .notification-bell { position: relative; }
    .notification-bell-button { position: relative; width: 38px; height: 38px; display:inline-flex; align-items:center; justify-content:center; color:#e2e8f0; background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.14); border-radius:50%; font-size:17px; }
    .notification-bell-count { position:absolute; top:-5px; right:-5px; min-width:17px; height:17px; padding:0 4px; border-radius:99px; background:#ef4444; color:white; font:10px/17px monospace; text-align:center; }
    .notification-bell-menu { width:min(360px,calc(100vw - 24px)); background:#202327; border:1px solid rgba(255,255,255,.12); box-shadow:0 18px 50px rgba(0,0,0,.4); }
    .notification-bell-list { max-height:380px; overflow-y:auto; }
    .notification-bell-item { display:flex; gap:10px; padding:12px 14px; text-decoration:none; border-bottom:1px solid rgba(255,255,255,.06); }
    .notification-bell-item:hover { background:rgba(255,255,255,.05); }
    .notification-bell-item.is-read { opacity:.68; }
    .notification-bell-dot { flex:0 0 8px; width:8px; height:8px; margin-top:6px; border-radius:50%; background:#00b3dd; }
    .notification-bell-item.is-read .notification-bell-dot { background:#64748b; }
</style>
<div class="notification-bell dropdown">
    <button class="notification-bell-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></svg>
        @if (Model.UnreadCount > 0 || Model.FlashMessages.Count > 0)
        {
            <span class="notification-bell-count">@(Model.UnreadCount + Model.FlashMessages.Count)</span>
        }
    </button>
    <div class="dropdown-menu dropdown-menu-end notification-bell-menu p-0">
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom border-secondary-subtle">
            <strong class="text-white">การแจ้งเตือน</strong>
            @if (Model.UnreadCount > 0)
            {
                <form asp-controller="Notifications" asp-action="ReadAll" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-link btn-sm p-0 text-info text-decoration-none" type="submit">อ่านทั้งหมด</button>
                </form>
            }
        </div>
        <div class="notification-bell-list">
            @foreach (var message in Model.FlashMessages)
            {
                <span class="notification-flash-source d-none" data-message="@message"></span>
                <div class="notification-bell-item notification-bell-flash">
                    <span class="notification-bell-dot"></span>
                    <div><div class="text-white">@message</div><small class="text-secondary">เมื่อสักครู่</small></div>
                </div>
            }
            @foreach (var notification in Model.Notifications)
            {
                <a class="notification-bell-item @(notification.IsRead ? "is-read" : "is-unread")"
                   asp-controller="Notifications" asp-action="Open" asp-route-id="@notification.NotificationId">
                    <span class="notification-bell-dot"></span>
                    <div>
                        <div class="text-white">@notification.Title</div>
                        @if (!string.IsNullOrWhiteSpace(notification.Body)) { <div class="text-secondary small">@notification.Body</div> }
                        <small class="text-secondary">@notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                </a>
            }
            @if (Model.Notifications.Count == 0 && Model.FlashMessages.Count == 0)
            {
                <div class="p-4 text-center text-secondary small">ไม่มีการแจ้งเตือนใหม่</div>
            }
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.notification-flash-source').forEach(source => {
            const message = source.dataset.message || '';
            const candidates = [...document.querySelectorAll('main .alert, main [role="alert"], main .bh-alert, main .origin-card-graphite, main .rounded-lg')];
            const oldBanner = candidates.filter(node => node.textContent.includes(message))
                .sort((a, b) => a.textContent.length - b.textContent.length)[0];
            if (oldBanner) oldBanner.remove();
        });
    });
</script>
