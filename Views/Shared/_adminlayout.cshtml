@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Admin</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f7f7f7;
            color: #333;
        }

        /* =========================
           LAYOUT
        ========================= */

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* =========================
           SIDEBAR
        ========================= */

        .admin-sidebar {
            width: 250px;
            min-height: 100vh;
            background: #ffffff;
            border-right: 1px solid #eeeeee;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
        }

        .admin-logo {
            height: 75px;
            display: flex;
            align-items: center;
            padding: 0 25px;
            border-bottom: 1px solid #eeeeee;
        }

        .admin-logo span {
            font-size: 23px;
            font-weight: bold;
            color: #f2b400;
        }

        .admin-menu {
            padding: 20px 12px;
        }

        .admin-menu-title {
            font-size: 12px;
            color: #999;
            margin: 10px 15px;
            text-transform: uppercase;
        }

        .admin-menu a {
            display: flex;
            align-items: center;
            gap: 12px;

            padding: 13px 15px;
            margin-bottom: 5px;

            text-decoration: none;
            color: #444;

            border-radius: 8px;

            transition: 0.2s;
        }

        .admin-menu a:hover {
            background: #fff8df;
            color: #f2b400;
        }

        .admin-menu a.active {
            background: #fff3c4;
            color: #d99f00;
            font-weight: 600;
        }

        /* =========================
           MAIN
        ========================= */

        .admin-main {
            margin-left: 250px;
            width: calc(100% - 250px);
        }

        /* =========================
           TOPBAR
        ========================= */

        .admin-topbar {
            height: 75px;
            background: #ffffff;
            border-bottom: 1px solid #eeeeee;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 30px;
        }

        .admin-page-title {
            font-size: 22px;
            font-weight: 600;
        }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .admin-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;

            background: #f2b400;
            color: #ffffff;

            display: flex;
            align-items: center;
            justify-content: center;

            font-weight: bold;
        }

        .logout-btn {
            text-decoration: none;
            color: #777;
        }

        .logout-btn:hover {
            color: #dc3545;
        }

        /* =========================
           CONTENT
        ========================= */

        .admin-content {
            padding: 30px;
        }

        /* =========================
           DASHBOARD CARD
        ========================= */

        .dashboard-card {
            background: #ffffff;
            border-radius: 12px;
            padding: 22px;

            border: 1px solid #eeeeee;

            transition: 0.2s;
        }

        .dashboard-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.06);
        }

        .dashboard-card-title {
            color: #888;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .dashboard-card-number {
            font-size: 28px;
            font-weight: bold;
        }

        .dashboard-icon {
            width: 45px;
            height: 45px;
            border-radius: 10px;

            background: #fff3c4;
            color: #e0a500;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 20px;
        }

        /* =========================
           TABLE
        ========================= */

        .admin-table {
            background: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #eeeeee;
        }

        .admin-table table {
            margin: 0;
        }

        .admin-table th {
            background: #fff8df;
            border-bottom: 1px solid #eeeeee;
            font-weight: 600;
        }

        /* =========================
           BUTTON
        ========================= */

        .btn-yellow {
            background: #f2b400;
            color: white;
            border: none;
            padding: 9px 18px;
            border-radius: 7px;
        }

        .btn-yellow:hover {
            background: #dca300;
            color: white;
        }

        /* =========================
           MOBILE
        ========================= */

        @@media (max-width: 900px) {

            .admin-sidebar {
                width: 210px;
            }

            .admin-main {
                margin-left: 210px;
                width: calc(100% - 210px);
            }

            .admin-content {
                padding: 20px;
            }

        }

    </style>
</head>

<body>

    <div class="admin-wrapper">

        <!-- SIDEBAR -->
        <aside class="admin-sidebar">

            <div class="admin-logo">
                <span>ADMIN PANEL</span>
            </div>

            <div class="admin-menu">

                <div class="admin-menu-title">
                    Main
                </div>

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="active">
                    Dashboard
                </a>

                <div class="admin-menu-title">
                    Management
                </div>

                <a asp-controller="Admin"
                   asp-action="Rooms">
                    ห้องพัก
                </a>

                <a asp-controller="Admin"
                   asp-action="Promotions">
                    โปรโมชั่น
                </a>

                <a asp-controller="Admin"
                   asp-action="Bookings">
                    การจอง
                </a>

                <a asp-controller="Admin"
                   asp-action="Users">
                    ผู้ใช้งาน
                </a>

                <a asp-controller="Admin"
                   asp-action="Employees">
                    พนักงาน
                </a>

            </div>

        </aside>


        <!-- MAIN -->
        <div class="admin-main">

            <!-- TOPBAR -->
            <header class="admin-topbar">

                <div class="admin-page-title">
                    @ViewData["Title"]
                </div>

                <div class="admin-user">

                    <div>
                        <strong>Admin</strong>
                    </div>

                    <div class="admin-avatar">
                        A
                    </div>

                    <a href="#" class="logout-btn">
                        ออกจากระบบ
                    </a>

                </div>

            </header>


            <!-- CONTENT -->
            <main class="admin-content">

                @RenderBody()

            </main>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>