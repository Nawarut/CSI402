@model Nawarut_8250_L005.Models.RegisterViewModel
@{
    ViewData["Title"] = "สมัครสมาชิกใหม่ (Register)";
    Layout = "_navbarlayout";
}

<div class="py-5" style="background-color: var(--color-obsidian); min-height: calc(100vh - 140px);">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">

                <!-- Origin Register Box: Graphite card, 16px radius, Void inputs -->
                <div class="origin-card-graphite p-4 p-md-5">
                    <div class="text-center pb-4 mb-4 border-bottom" style="border-color: rgba(255,255,255,0.08) !important;">
                        <span class="origin-pill-chip mb-2">RESIDENT ACCESSION</span>
                        <h2 class="origin-heading-lg mb-1" style="font-size: 28px;">สร้างบัญชีผู้ใช้งานใหม่</h2>
                        <p class="origin-mono mb-0" style="color: var(--color-ash); font-size: 11px;">JOJO HOTEL &middot; JOIN OUR COMMUNITY</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="p-3 mb-4 border border-danger-subtle rounded-3" style="background-color: rgba(15,16,17,0.7);">
                            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                            {
                                <div class="small text-danger">&times; @error.ErrorMessage</div>
                            }
                        </div>
                    }

                    <form asp-action="Register" asp-controller="Account" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Full Name -->
                        <div class="mb-4">
                            <label asp-for="FullName" class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">ชื่อ-นามสกุล (FULL NAME) *</label>
                            <input asp-for="FullName" class="origin-input w-100" placeholder="เช่น นายสมเกียรติ รักสงบ" />
                            <span asp-validation-for="FullName" class="small text-danger"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-4">
                            <label asp-for="Email" class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">อีเมลผู้ใช้งาน (EMAIL) *</label>
                            <input asp-for="Email" class="origin-input w-100" placeholder="user@example.com" />
                            <span asp-validation-for="Email" class="small text-danger"></span>
                        </div>

                        <!-- Phone Number -->
                        <div class="mb-4">
                            <label asp-for="PhoneNumber" class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">เบอร์โทรศัพท์ติดต่อ (PHONE NUMBER) *</label>
                            <input asp-for="PhoneNumber" class="origin-input w-100" placeholder="08x-xxx-xxxx" />
                            <span asp-validation-for="PhoneNumber" class="small text-danger"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <!-- Password -->
                            <div class="col-12 col-md-6">
                                <label asp-for="Password" class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">รหัสผ่าน (PASSWORD) *</label>
                                <input asp-for="Password" type="password" class="origin-input w-100" placeholder="••••••••" />
                                <span asp-validation-for="Password" class="small text-danger"></span>
                            </div>

                            <!-- Confirm Password -->
                            <div class="col-12 col-md-6">
                                <label asp-for="ConfirmPassword" class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">ยืนยันรหัสผ่าน (CONFIRM) *</label>
                                <input asp-for="ConfirmPassword" type="password" class="origin-input w-100" placeholder="••••••••" />
                                <span asp-validation-for="ConfirmPassword" class="small text-danger"></span>
                            </div>
                        </div>

                        <!-- Notice -->
                        <div class="origin-mono mb-4" style="color: var(--color-ash); font-size: 11px; line-height: 1.6;">
                            โดยการลงทะเบียน ท่านยอมรับข้อตกลงและระเบียบการเข้าพักของ JoJo Hotel &amp; Resorts
                        </div>

                        <!-- Submit Button: White-on-Black Primary CTA Button -->
                        <button type="submit" class="btn-origin-primary w-100 justify-content-center py-3 mb-4">
                            ลงทะเบียนสมาชิกใหม่ &rarr;
                        </button>
                    </form>

                    <!-- Login Link -->
                    <div class="text-center pt-3 border-top" style="border-color: rgba(255,255,255,0.08) !important;">
                        <span class="origin-mono" style="color: var(--color-ash); font-size: 11px;">มีบัญชีผู้ใช้งานอยู่แล้ว? </span>
                        <a asp-action="Login" asp-controller="Account" class="origin-mono text-decoration-none" style="color: var(--color-iris-gleam); font-size: 11px;">
                            เข้าสู่ระบบที่นี่ &rarr;
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
