@model Nawarut_8250_L005.Models.LoginViewModel
@{
    ViewData["Title"] = "เข้าสู่ระบบ (Login)";
    Layout = "_navbarlayout";
}

<div class="auth-page-wrapper">
    <div class="container py-5">
        <div class="row justify-content-center align-items-center min-vh-75">
            <div class="col-12 col-md-8 col-lg-5">

                <!-- Alert Messages -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                        <div class="d-flex align-items-center">
                            <span class="fs-4 me-2">✅</span>
                            <div>@TempData["SuccessMessage"]</div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                        <div class="d-flex align-items-center">
                            <span class="fs-4 me-2">ℹ️</span>
                            <div>@TempData["InfoMessage"]</div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Main Login Card -->
                <div class="card auth-card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-header bg-white border-0 text-center pt-4 pb-2">
                        <div class="auth-badge-icon mx-auto mb-3">
                            <span class="fs-2">🔐</span>
                        </div>
                        <h3 class="fw-bold text-dark mb-1">เข้าสู่ระบบ</h3>
                        <p class="text-muted small">JoJo Travel & Hotel Management System</p>
                    </div>

                    <div class="card-body p-4 pt-2">
                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                        {
                            <div class="alert alert-danger rounded-3 py-2 px-3 mb-3 small">
                                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                                {
                                    <div>⚠️ @error.ErrorMessage</div>
                                }
                            </div>
                        }

                        <form asp-action="Login" asp-controller="Account" method="post" id="loginForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                            <!-- Email -->
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold text-secondary small">อีเมลผู้ใช้งาน</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">✉️</span>
                                    <input asp-for="Email" id="emailInput" class="form-control bg-light border-start-0 ps-0" placeholder="เช่น admin@jojo.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Password -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label asp-for="Password" class="form-label fw-semibold text-secondary small">รหัสผ่าน</label>
                                    <a href="#" class="small text-decoration-none text-muted" onclick="alert('กรุณาติดต่อผู้ดูแลระบบเพื่อรีเซ็ตรหัสผ่าน'); return false;">ลืมรหัสผ่าน?</a>
                                </div>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">🔑</span>
                                    <input asp-for="Password" id="passwordInput" type="password" class="form-control bg-light border-start-0 ps-0" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <!-- Remember Me -->
                            <div class="form-check mb-4">
                                <input asp-for="RememberMe" class="form-check-input custom-checkbox" />
                                <label asp-for="RememberMe" class="form-check-label small text-muted">จดจำการเข้าสู่ระบบ</label>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-primary-hotel w-100 py-2 fs-6 fw-bold rounded-3 shadow-sm mb-3">
                                เข้าสู่ระบบ
                            </button>
                        </form>

                        <!-- Quick Test Accounts Helper -->
                        <div class="quick-login-box rounded-3 p-3 mt-3 bg-light border">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small fw-bold text-secondary">🚀 บัญชีสำหรับทดสอบ:</span>
                                <span class="badge bg-warning text-dark">คลิกเพื่อกรอกอัตโนมัติ</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <button type="button" class="btn btn-sm btn-outline-warning w-100 text-dark text-start" onclick="fillCredentials('admin@jojo.com', 'admin123')">
                                        <div class="fw-bold text-dark">👑 Admin</div>
                                        <div class="text-muted" style="font-size: 11px;">admin@jojo.com</div>
                                    </button>
                                </div>
                                <div class="col-6">
                                    <button type="button" class="btn btn-sm btn-outline-secondary w-100 text-dark text-start" onclick="fillCredentials('somchai@gmail.com', 'user123')">
                                        <div class="fw-bold text-dark">👤 User ทั่วไป</div>
                                        <div class="text-muted" style="font-size: 11px;">somchai@gmail.com</div>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Footer Links -->
                        <div class="text-center mt-4 pt-2 border-top">
                            <span class="small text-muted">ยังไม่มีบัญชีผู้ใช้งาน? </span>
                            <a asp-action="Register" asp-controller="Account" class="small fw-bold text-decoration-none text-golden">
                                สมัครสมาชิกใหม่ที่นี่
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .auth-page-wrapper {
        background: linear-gradient(135deg, #fffdf8 0%, #f7f5ef 100%);
        min-height: calc(100vh - 72px);
    }

    .auth-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        background: #ffffff;
    }

    .auth-badge-icon {
        width: 60px;
        height: 60px;
        background: #fff8df;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #ffe89e;
    }

    .btn-primary-hotel {
        background: #f2b400;
        border: none;
        color: #ffffff;
        transition: all 0.2s ease;
    }

    .btn-primary-hotel:hover {
        background: #d99f00;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(242, 180, 0, 0.3);
    }

    .text-golden {
        color: #d99f00;
    }

    .text-golden:hover {
        color: #b88600;
        text-decoration: underline !important;
    }

    .form-control:focus {
        border-color: #f2b400;
        box-shadow: 0 0 0 0.25rem rgba(242, 180, 0, 0.2);
    }

    .custom-checkbox:checked {
        background-color: #f2b400;
        border-color: #f2b400;
    }

    .quick-login-box {
        border-left: 4px solid #f2b400 !important;
    }
</style>

<script>
    function fillCredentials(email, pass) {
        document.getElementById('emailInput').value = email;
        document.getElementById('passwordInput').value = pass;
    }
</script>
