@model Nawarut_8250_L005.Models.LoginViewModel
@{
    ViewData["Title"] = "เข้าสู่ระบบ (Login)";
    Layout = "_navbarlayout";
}

<div class="py-5" style="background-color: var(--color-obsidian); min-height: calc(100vh - 140px);">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-5">

                <!-- Alert Messages -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="origin-card-graphite p-3 mb-4 d-flex justify-content-between align-items-center" role="alert">
                        <span class="small">&middot; @TempData["SuccessMessage"]</span>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["InfoMessage"] != null)
                {
                    <div class="origin-card-graphite p-3 mb-4 d-flex justify-content-between align-items-center" role="alert">
                        <span class="small">&middot; @TempData["InfoMessage"]</span>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Origin Login Box: Graphite card, 16px radius, Void inputs -->
                <div class="origin-card-graphite p-4 p-md-5">
                    <div class="text-center pb-4 mb-4 border-bottom" style="border-color: rgba(255,255,255,0.08) !important;">
                        <span class="origin-pill-chip mb-2">SECURITY PORTAL</span>
                        <h2 class="origin-heading-lg mb-1" style="font-size: 28px;">เข้าสู่ระบบ</h2>
                        <p class="origin-mono mb-0" style="color: var(--color-ash); font-size: 11px;">JOJO HOTEL &middot; RESIDENT ACCESS</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="p-3 mb-4 border border-danger-subtle rounded-3" style="background-color: rgba(15,16,17,0.7);">
                            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                            {
                                <div class="small text-danger">&times; @error.ErrorMessage</div>
                            }
                        </div>
                    }

                    <form asp-action="Login" asp-controller="Account" method="post" id="loginForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                        <!-- Email -->
                        <div class="mb-4">
                            <label asp-for="Email" class="origin-mono d-block mb-2" style="color: var(--color-ash); font-size: 11px;">อีเมลผู้ใช้งาน (EMAIL)</label>
                            <input asp-for="Email" id="emailInput" class="origin-input w-100" placeholder="admin@jojo.com" />
                            <span asp-validation-for="Email" class="small text-danger"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label asp-for="Password" class="origin-mono mb-0" style="color: var(--color-ash); font-size: 11px;">รหัสผ่าน (PASSWORD)</label>
                                <a href="#" class="origin-mono text-decoration-none" style="color: var(--color-ash); font-size: 10px;" onclick="alert('กรุณาติดต่อผู้ดูแลระบบเพื่อรีเซ็ตรหัสผ่าน'); return false;">ลืมรหัสผ่าน?</a>
                            </div>
                            <input asp-for="Password" id="passwordInput" type="password" class="origin-input w-100" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="small text-danger"></span>
                        </div>

                        <!-- Remember Me -->
                        <div class="form-check mb-4">
                            <input asp-for="RememberMe" class="form-check-input" style="border-radius: 4px; background-color: var(--color-void); border-color: rgba(255,255,255,0.3);" />
                            <label asp-for="RememberMe" class="origin-mono" style="color: var(--color-ash); font-size: 11px;">จดจำการเข้าสู่ระบบ</label>
                        </div>

                        <!-- Submit Button: White-on-Black Primary CTA Button -->
                        <button type="submit" class="btn-origin-primary w-100 justify-content-center py-3 mb-4">
                            เข้าสู่ระบบ &rarr;
                        </button>
                    </form>

                    <!-- Test Credentials Helper for All 5 Roles (Symmetrical, Equal Proportions) -->
                    <style>
                        .quick-role-box {
                            display: flex;
                            flex-direction: column;
                            justify-content: center;
                            background: rgba(255, 255, 255, 0.03);
                            border: 1px solid rgba(255, 255, 255, 0.1);
                            border-radius: 8px;
                            padding: 8px 12px;
                            min-height: 52px;
                            height: 100%;
                            width: 100%;
                            text-align: left;
                            transition: all 0.2s ease;
                            cursor: pointer;
                        }
                        .quick-role-box:hover {
                            background: rgba(255, 255, 255, 0.07);
                            border-color: rgba(255, 255, 255, 0.28);
                            transform: translateY(-1px);
                        }
                        .quick-role-title {
                            font-size: 11px;
                            font-weight: 600;
                            line-height: 1.2;
                            letter-spacing: 0.02em;
                        }
                        .quick-role-email {
                            font-family: var(--font-roboto-mono), monospace;
                            font-size: 9px;
                            color: var(--color-ash);
                            margin-top: 3px;
                            letter-spacing: 0.03em;
                        }
                    </style>

                    <div class="p-3 mb-4 rounded-3" style="background-color: rgba(15,16,17,0.7); border: 1px solid rgba(255,255,255,0.08);">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="origin-mono" style="color: var(--color-cyan-signal); font-size: 10px;">บัญชีสำหรับทดสอบ (คลิกเพื่อเข้าสู่ระบบ):</span>
                            <span class="origin-mono" style="color: var(--color-ash); font-size: 9px;">5 ROLES</span>
                        </div>
                        <div class="row g-2 align-items-stretch">
                            <!-- 1. Admin -->
                            <div class="col-6">
                                <button type="button" class="quick-role-box" onclick="fillAndSubmit('admin@jojo.com', 'admin123')">
                                    <div class="quick-role-title text-white"><i class="bi bi-shield-lock me-1"></i> ADMIN</div>
                                    <div class="quick-role-email text-truncate">ADMIN@JOJO.COM</div>
                                </button>
                            </div>

                            <!-- 2. Reception / Staff -->
                            <div class="col-6">
                                <button type="button" class="quick-role-box" onclick="fillAndSubmit('reception@jojo.com', 'staff123')">
                                    <div class="quick-role-title" style="color: var(--color-cyan-signal);"><i class="bi bi-bell me-1"></i> RECEPTION</div>
                                    <div class="quick-role-email text-truncate">RECEPTION@JOJO.COM</div>
                                </button>
                            </div>

                            <!-- 3. Accounting -->
                            <div class="col-6">
                                <button type="button" class="quick-role-box" onclick="fillAndSubmit('accountant@jojo.com', 'acc123')">
                                    <div class="quick-role-title" style="color: var(--color-orchid-bloom);"><i class="bi bi-wallet2 me-1"></i> ACCOUNTING</div>
                                    <div class="quick-role-email text-truncate">ACCOUNTANT@JOJO.COM</div>
                                </button>
                            </div>

                            <!-- 4. Customer Service -->
                            <div class="col-6">
                                <button type="button" class="quick-role-box" onclick="fillAndSubmit('support@jojo.com', 'support123')">
                                    <div class="quick-role-title" style="color: var(--color-periwinkle);"><i class="bi bi-headset me-1"></i> C-SERVICE</div>
                                    <div class="quick-role-email text-truncate">SUPPORT@JOJO.COM</div>
                                </button>
                            </div>

                            <!-- 5. User / Customer (Full width, same sleek height & balanced alignment) -->
                            <div class="col-12">
                                <button type="button" class="quick-role-box flex-row align-items-center justify-content-between" onclick="fillAndSubmit('somchai@gmail.com', 'user123')">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="quick-role-title text-white"><i class="bi bi-person-circle me-1"></i> CUSTOMER</span>
                                        <span class="badge border rounded-pill px-2 py-0" style="font-size: 9px; color: var(--color-iris-gleam); border-color: rgba(132,125,255,0.4);">ลูกค้า</span>
                                    </div>
                                    <span class="quick-role-email mb-0 text-white-50">SOMCHAI@GMAIL.COM</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Register Link -->
                    <div class="text-center pt-3 border-top" style="border-color: rgba(255,255,255,0.08) !important;">
                        <span class="origin-mono" style="color: var(--color-ash); font-size: 11px;">ยังไม่มีบัญชีผู้ใช้งาน? </span>
                        <a asp-action="Register" asp-controller="Account" class="origin-mono text-decoration-none" style="color: var(--color-iris-gleam); font-size: 11px;">
                            สมัครสมาชิกใหม่ที่นี่ &rarr;
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    function fillCredentials(email, pass) {
        document.getElementById('emailInput').value = email;
        document.getElementById('passwordInput').value = pass;
    }

    function fillAndSubmit(email, pass) {
        fillCredentials(email, pass);
        // เล็กน้อยเพื่อให้ผู้ใช้เห็นว่าฟิลด์ถูกเติม แล้วส่งฟอร์มทันที
        setTimeout(function() {
            var form = document.getElementById('loginForm') || document.querySelector('form');
            if (form) form.submit();
        }, 150);
    }
</script>
