@model List<Nawarut_8250_L005.Entities.Ticket>
@{
    ViewData["Title"] = "Customer Support";
    Layout = "~/Views/Shared/_navbarlayout.cshtml";
    var bookings = ViewBag.Bookings as List<Nawarut_8250_L005.Entities.Booking> ?? new();
}

<div class="container py-5" style="max-width: 1000px; min-height: 75vh;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="origin-mono small" style="color:var(--color-iris-gleam)">CUSTOMER CARE</div>
            <h1 class="origin-heading-lg text-white mb-1">แจ้งปัญหา / ติดต่อ Customer Service</h1>
            <p class="text-secondary mb-0">ส่งเรื่องสอบถามเกี่ยวกับการจองหรือบริการ และติดตามหมายเลข Ticket ได้ที่นี่</p>
        </div>
        <a asp-controller="Account" asp-action="BookingHistory" class="btn-origin-ghost px-3 py-2">ประวัติการจอง</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="origin-card-graphite p-4 mb-4">
        <h2 class="origin-heading-lg text-white fs-4 mb-3">ส่งเรื่องใหม่</h2>
        <form method="post" asp-action="CreateSupportTicket" asp-controller="Account">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label text-light">รายการจองที่เกี่ยวข้อง</label>
                    <select name="bookingId" class="origin-input w-100">
                        <option value="">ไม่เกี่ยวกับการจอง / ทั่วไป</option>
                        @foreach (var booking in bookings)
                        {
                            <option value="@booking.BookingId">@booking.BookingCode — @booking.CheckInDate.ToString("dd/MM/yyyy")</option>
                        }
                    </select>
                </div>
                <div class="col-md-7">
                    <label class="form-label text-light">หัวข้อ</label>
                    <input name="subject" class="origin-input w-100" maxlength="150" minlength="3" required placeholder="เช่น สอบถามยอดชำระวันเช็กอิน" />
                </div>
                <div class="col-12">
                    <label class="form-label text-light">รายละเอียด</label>
                    <textarea name="message" class="origin-input w-100" rows="4" minlength="5" maxlength="4000" required placeholder="อธิบายปัญหาหรือคำถามของคุณ"></textarea>
                </div>
                <div class="col-12 text-end">
                    <button type="submit" class="btn-origin-primary px-4 py-2">ส่งให้ Customer Service</button>
                </div>
            </div>
        </form>
    </div>

    <h2 class="origin-heading-lg text-white fs-4 mb-3">เรื่องที่ส่งแล้ว</h2>
    @if (Model.Count == 0)
    {
        <div class="origin-card-graphite p-4 text-secondary">ยังไม่มี Ticket</div>
    }
    else
    {
        @foreach (var ticket in Model)
        {
            <article class="origin-card-graphite p-4 mb-3">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <div>
                        <div class="origin-mono small" style="color:var(--color-cyan-signal)">@ticket.TicketCode · @ticket.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                        <h3 class="text-white fs-5 mt-2">@ticket.Subject</h3>
                        @if (ticket.Booking != null) { <div class="text-secondary small">Booking @ticket.Booking.BookingCode</div> }
                    </div>
                    <span class="badge rounded-pill bg-secondary align-self-start">@ticket.Status</span>
                </div>
                @foreach (var reply in ticket.TicketMessages.Where(m => !m.IsInternal).OrderBy(m => m.CreatedAt))
                {
                    <div class="mt-3 p-3 rounded" style="background:rgba(255,255,255,.04)">
                        <div class="text-secondary small mb-1">@reply.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="text-light" style="white-space:pre-wrap">@reply.Message</div>
                    </div>
                }
            </article>
        }
    }
</div>
