@model Nawarut_8250_L005.Entities.Booking
@{
    Layout = null;
    var depositPct = Model.DepositPercent <= 1m ? Model.DepositPercent * 100m : Model.DepositPercent;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>ใบเสร็จรับเงิน #REC-@Model.BookingCode — JoJo Hotel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600&family=Prompt:wght@300;400;500;600&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
        body {
            background-color: #f8fafc;
            font-family: 'Prompt', sans-serif;
            color: #1e293b;
            padding: 40px 20px;
        }
        .receipt-card {
            max-width: 800px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
            padding: 48px;
            border: 1px solid #e2e8f0;
        }
        .mono { font-family: 'Roboto Mono', monospace; }
        .receipt-title { font-family: 'DM Serif Display', serif; font-size: 28px; }
        .paid-stamp {
            border: 2px solid #16a34a;
            color: #16a34a;
            font-family: 'Roboto Mono', monospace;
            font-size: 14px;
            font-weight: bold;
            padding: 4px 14px;
            border-radius: 6px;
            display: inline-block;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }
        @@media print {
            body { padding: 0; background: #fff; }
            .receipt-card { box-shadow: none; border: none; padding: 0; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>

    <div class="receipt-card">

        <!-- Top Actions -->
        <div class="d-flex justify-content-between align-items-center mb-4 no-print pb-3 border-bottom">
            <a href="javascript:window.close()" class="btn btn-sm btn-outline-secondary">
                &larr; ปิดหน้านี้
            </a>
            <button onclick="window.print()" class="btn btn-sm btn-dark px-4">
                <i class="bi bi-printer me-1"></i> พิมพ์ใบเสร็จรับเงิน (Print)
            </button>
        </div>

        <!-- Receipt Header -->
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h1 class="receipt-title mb-1">JoJo Hotel &middot; Residences</h1>
                <p class="text-muted small mb-0">123 Sukhumvit Road, Bangkok 10110, Thailand</p>
                <p class="text-muted small mb-0">โทร: +66 (0) 2 123 4567 | เลขประจำตัวผู้เสียภาษี: 0105566009988</p>
            </div>
            <div class="text-end">
                <span class="paid-stamp mb-2">PAID / ชำระแล้ว</span>
                <div class="mono small text-muted">เลขที่ใบเสร็จ: REC-@Model.BookingCode</div>
                <div class="mono small text-muted">วันที่: @DateTime.Now.ToString("dd MMMM yyyy")</div>
            </div>
        </div>

        <hr />

        <!-- Customer & Booking Info -->
        <div class="row g-3 my-3">
            <div class="col-6">
                <div class="mono text-muted small">ผู้รับบริการ (CUSTOMER)</div>
                <div class="fw-bold fs-6">@Model.User?.FirstName @Model.User?.LastName</div>
                <div class="text-muted small">อีเมล: @Model.User?.Email</div>
                <div class="text-muted small">เบอร์โทรศัพท์: @(Model.User?.Phone ?? "-")</div>
            </div>
            <div class="col-6 text-end">
                <div class="mono text-muted small">ข้อมูลการจอง (RESERVATION)</div>
                <div class="mono fw-bold">รหัสการจอง: #@Model.BookingCode</div>
                <div class="small">เช็คอิน: <strong>@Model.CheckInDate.ToString("dd/MM/yyyy") (09:00 น.)</strong></div>
                <div class="small">เช็คเอาท์: <strong>@Model.CheckOutDate.ToString("dd/MM/yyyy") (12:00 น.)</strong></div>
                <div class="small text-muted">ระยะเวลา: @Model.Nights คืน | ผู้เข้าพัก: @Model.TotalGuests ท่าน</div>
            </div>
        </div>

        <!-- Itemized Table -->
        <div class="table-responsive my-4">
            <table class="table table-bordered mb-0">
                <thead class="table-light mono small">
                    <tr>
                        <th>ลำดับ</th>
                        <th>รายการห้องพัก / รายละเอียด</th>
                        <th class="text-center">จำนวนคืน</th>
                        <th class="text-end">ราคา/คืน</th>
                        <th class="text-end">รวมเป็นเงิน</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int idx = 1; }
                    @foreach (var r in Model.BookingRooms)
                    {
                        <tr>
                            <td class="text-center mono">@idx</td>
                            <td>
                                <div class="fw-bold">@r.Room?.RoomType?.TypeName</div>
                                <div class="text-muted small">ห้องพักหมายเลข #@r.Room?.RoomNumber (เตียงเสริม: @r.ExtraBeds)</div>
                            </td>
                            <td class="text-center mono">@Model.Nights</td>
                            <td class="text-end mono">฿@r.PricePerNight.ToString("N2")</td>
                            <td class="text-end mono fw-bold">฿@r.LineTotal.ToString("N2")</td>
                        </tr>
                        idx++;
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-end">ยอดรวมค่าห้องพัก (Subtotal):</td>
                        <td class="text-end mono">฿@Model.SubtotalAmount.ToString("N2")</td>
                    </tr>
                    @if (Model.ExtraBedAmount > 0)
                    {
                        <tr>
                            <td colspan="4" class="text-end">ค่าบริการเตียงเสริม:</td>
                            <td class="text-end mono">+฿@Model.ExtraBedAmount.ToString("N2")</td>
                        </tr>
                    }
                    @if (Model.DiscountAmount > 0)
                    {
                        <tr class="text-success">
                            <td colspan="4" class="text-end">ส่วนลดโปรโมชั่น:</td>
                            <td class="text-end mono">−฿@Model.DiscountAmount.ToString("N2")</td>
                        </tr>
                    }
                    <tr class="table-light fw-bold">
                        <td colspan="4" class="text-end fs-6">ยอดสุทธิรวมทั้งสิ้น (Net Total):</td>
                        <td class="text-end mono fs-6">฿@Model.NetAmount.ToString("N2")</td>
                    </tr>
                    <tr class="table-success fw-bold">
                        <td colspan="4" class="text-end text-success">
                            <i class="bi bi-check-circle me-1"></i> ยอดมัดจำ 5% ที่ชำระแล้ว (Deposit Paid @depositPct.ToString("0")%):
                        </td>
                        <td class="text-end mono text-success">฿@Model.DepositAmount.ToString("N2")</td>
                    </tr>
                    <tr class="text-muted">
                        <td colspan="4" class="text-end">ยอดคงเหลือชำระ ณ วันเช็คอิน:</td>
                        <td class="text-end mono">฿@((Model.NetAmount - Model.DepositAmount).ToString("N2"))</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Receipt Footer -->
        <div class="row pt-4 mt-4 border-top">
            <div class="col-8">
                <div class="mono small text-muted">หมายเหตุและเงื่อนไข:</div>
                <div class="text-muted" style="font-size: 11px;">
                    1. ใบเสร็จรับเงินนี้ออกให้สำหรับค่ามัดจำล่วงหน้า 5% ของยอดสุทธิ<br />
                    2. เวลาเช็คอินมาตรฐาน 09:00 น. และเช็คเอาท์ 12:00 น.<br />
                    3. กรุณาแสดงใบเสร็จนี้แก่พนักงานต้อนรับในวันเช็คอิน
                </div>
            </div>
            <div class="col-4 text-center">
                <div class="mb-4 text-muted small mono">ผู้มีอำนาจลงนาม</div>
                <div class="border-bottom mx-auto" style="width: 140px;"></div>
                <div class="small fw-bold mt-2">ฝ่ายบัญชีและการเงิน</div>
                <div class="text-muted" style="font-size: 10px;">JoJo Hotel Thailand</div>
            </div>
        </div>

    </div>

</body>
</html>

