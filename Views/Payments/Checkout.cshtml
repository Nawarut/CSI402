@model Nawarut_8250_L005.ViewModels.PaymentCheckoutViewModel
@{
    ViewData["Title"] = "ชำระเงินจำลอง";
    Layout = "~/Views/Shared/_navbarlayout.cshtml";
    var booking = Model.Booking;
    var isDeposit = Model.PaymentType == "deposit";
}

<style>
    .pay-shell { max-width: 1000px; margin: 0 auto; padding: 48px 20px 80px; }
    .pay-card { background: var(--color-graphite); border: 1px solid rgba(255,255,255,.1); border-radius: 18px; }
    .mock-qr { width: 194px; height: 194px; display: block; margin: 12px auto; background: white; padding: 10px; border-radius: 10px; }
    .pay-method-choice { border: 1px solid rgba(255,255,255,.12); border-radius: 12px; padding: 14px; cursor: pointer; }
    .pay-method-choice:has(input:checked) { border-color: var(--color-cyan-signal); background: rgba(0,179,221,.08); }
</style>

<main class="pay-shell">
    <div class="mb-4">
        <div class="origin-mono small" style="color:var(--color-cyan-signal)">MOCK PAYMENT · DEMO ONLY</div>
        <h1 class="origin-heading-lg text-white">@((isDeposit) ? "ชำระค่ามัดจำ" : "ชำระยอดค่าห้องคงเหลือ")</h1>
        <p class="text-secondary mb-0">รหัสการจอง @booking.BookingCode</p>
    </div>

    <div class="row g-4">
        <section class="col-lg-5">
            <div class="pay-card p-4 h-100">
                <div class="text-secondary small">@(isDeposit ? "ค่ามัดจำ 5%" : "ยอดคงเหลือ 95%")</div>
                <div class="origin-heading-lg my-2" style="font-size:36px;color:var(--color-cyan-signal)">฿@Model.Amount.ToString("N2")</div>
                <div class="text-secondary small">ยอดจองทั้งหมด ฿@booking.NetAmount.ToString("N2")</div>
                <hr class="border-secondary" />
                <div class="d-flex justify-content-between text-light small"><span>วันเช็กอิน</span><span>@booking.CheckInDate.ToString("dd/MM/yyyy")</span></div>
                <div class="d-flex justify-content-between text-light small mt-2"><span>วันเช็กเอาท์</span><span>@booking.CheckOutDate.ToString("dd/MM/yyyy")</span></div>
                <p class="small text-warning mt-4 mb-0">หน้าชำระเงินนี้เป็นแบบจำลอง ไม่มีการตัดเงินจริง และ QR ไม่สามารถสแกนชำระเงินจริงได้</p>
            </div>
        </section>

        <section class="col-lg-7">
            <form method="post" asp-action="ProcessMockPayment" asp-controller="Payments" class="pay-card p-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" value="@booking.BookingId" />
                <input type="hidden" name="type" value="@Model.PaymentType" />
                @if (TempData.Peek("ErrorMessage") is string error) { <div class="text-danger small mb-3">@error</div> }

                <h2 class="text-white fs-5 mb-3">เลือกวิธีชำระเงิน</h2>
                <label class="pay-method-choice d-flex gap-3 align-items-center mb-3 w-100">
                    <input type="radio" name="method" value="promptpay" checked />
                    <span><i class="bi bi-qr-code me-2 text-info"></i><strong class="text-white">PromptPay QR (จำลอง)</strong><small class="d-block text-secondary">แสดง QR mock สำหรับตัวอย่างเท่านั้น</small></span>
                </label>
                <div id="qrPaymentPanel" class="text-center p-3 mb-3 rounded-3" style="background:rgba(255,255,255,.04)">
                    <svg class="mock-qr" viewBox="0 0 21 21" role="img" aria-label="Mock QR code">
                        @for (var row = 0; row < 21; row++)
                        {
                            @for (var col = 0; col < 21; col++)
                            {
                                var finder = (row < 7 && col < 7) || (row < 7 && col > 13) || (row > 13 && col < 7);
                                var finderOn = finder && (row % 7 is 0 or 6 || col % 7 is 0 or 6 || (row % 7 is >= 2 and <= 4 && col % 7 is >= 2 and <= 4));
                                var dataOn = !finder && ((row * 7 + col * 13 + row * col) % 5 < 2 || (row + col) % 7 == 0);
                                if (finderOn || dataOn) { <rect x="@col" y="@row" width="1" height="1" fill="#111827" /> }
                            }
                        }
                    </svg>
                    <div class="text-secondary small">@booking.BookingCode · ฿@Model.Amount.ToString("N2") · QR จำลอง</div>
                </div>

                <label class="pay-method-choice d-flex gap-3 align-items-center mb-3 w-100">
                    <input type="radio" name="method" value="credit_card" />
                    <span><i class="bi bi-credit-card me-2 text-info"></i><strong class="text-white">บัตรเครดิต/เดบิต (จำลอง)</strong><small class="d-block text-secondary">กรอกข้อมูลทดสอบ ระบบจะไม่บันทึกเลขบัตร</small></span>
                </label>
                <div id="cardPaymentPanel" class="d-none">
                    <div class="mb-3"><label class="form-label text-light">ชื่อบนบัตร</label><input name="cardholder" class="origin-input w-100" autocomplete="off" /></div>
                    <div class="mb-3"><label class="form-label text-light">หมายเลขบัตรทดสอบ</label><input name="cardNumber" class="origin-input w-100" inputmode="numeric" autocomplete="off" placeholder="4242 4242 4242 4242" /></div>
                    <div class="row g-3">
                        <div class="col-6"><label class="form-label text-light">หมดอายุ (MM/YY)</label><input name="expiry" class="origin-input w-100" placeholder="12/30" autocomplete="off" /></div>
                        <div class="col-6"><label class="form-label text-light">CVV</label><input name="cvv" class="origin-input w-100" inputmode="numeric" autocomplete="off" placeholder="123" /></div>
                    </div>
                </div>
                <button class="btn-origin-primary w-100 justify-content-center py-3 mt-3" type="submit">ยืนยันการชำระจำลอง ฿@Model.Amount.ToString("N2")</button>
                <a asp-controller="Account" asp-action="BookingHistory" class="btn-origin-ghost w-100 justify-content-center py-2 mt-2 text-decoration-none">กลับไปประวัติการจอง</a>
            </form>
        </section>
    </div>
</main>

<script>
    document.querySelectorAll('input[name="method"]').forEach(input => input.addEventListener('change', () => {
        const card = document.querySelector('input[name="method"][value="credit_card"]').checked;
        document.getElementById('cardPaymentPanel').classList.toggle('d-none', !card);
        document.getElementById('qrPaymentPanel').classList.toggle('d-none', card);
        document.querySelectorAll('#cardPaymentPanel input').forEach(field => field.required = card);
    }));
</script>
